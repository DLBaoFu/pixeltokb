{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixeltokb",
  "compatibility_date": "2026-10-12",
  "main": "src/sitemap-worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/sitemap.xml"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
