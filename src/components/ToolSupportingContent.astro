---
import type { Locale } from '../lib/locales';

type ToolKind = 'compress' | 'resize' | 'crop' | 'size' | 'dpi';
interface Props { locale?: Locale; tool: ToolKind; }
const { locale = 'en', tool } = Astro.props;
const prefix = locale === 'en' ? '' : `/${locale}`;

type Link = [title: string, text: string, href: string];
type Content = { method: string; limitation: string; related: Link[]; heading: string; methodLabel: string; limitLabel: string; relatedLabel: string; action: string };
const content: Record<'en' | 'zh-cn' | 'zh-tw', Record<ToolKind, Content>> = {
  en: {
    compress: { heading: 'Before you export', methodLabel: 'What this tool checks', method: 'The compressor uses the selected target as a byte budget. It checks the generated Blob before showing a download link, so a rounded KB label is never used as the pass condition.', limitLabel: 'Known limits', limitation: 'A target may be unreachable when dimensions must stay fixed. PNG is lossless, and photos or images with transparency can need more bytes than a similarly sized JPEG or WebP.', relatedLabel: 'Related tools and guides', action: 'Open', related: [['Check file size and pixels', 'Inspect the source before choosing a target.', '/image-size-checker/'], ['Resize image', 'Reduce pixel dimensions when the destination allows it.', '/resize-image/'], ['Why an image may miss a 50 KB limit', 'Understand why detail, transparency, and format change the result.', '/blog/why-image-wont-fit-50kb/']] },
    resize: { heading: 'Choose the right resize mode', methodLabel: 'How the modes differ', method: 'Fit keeps the complete image and adds unused space where the output format supports it. Fill covers the target box by trimming the centered edges. Stretch uses the exact dimensions and changes the image proportions.', limitLabel: 'Known limits', limitation: 'Changing pixel dimensions does not guarantee a particular file size or print result. Check the exported dimensions and the receiving service’s format rules before submitting a file.', relatedLabel: 'Related tools and guides', action: 'Open', related: [['Crop image', 'Choose the exact part of the image to keep.', '/crop-image/'], ['Image size checker', 'Confirm pixels, bytes, and aspect ratio.', '/image-size-checker/'], ['Check image size, pixels, and DPI', 'Learn which measurement is relevant to an upload or print workflow.', '/blog/check-image-size-and-dpi/']] },
    crop: { heading: 'Crop with exact coordinates', methodLabel: 'How the selection works', method: 'Dragging on the preview creates a pixel crop box. You can then refine its left edge, top edge, width, and height with the numeric fields before exporting.', limitLabel: 'Known limits', limitation: 'Cropping permanently excludes pixels outside the selected region in the exported file. Use PNG or WebP when a transparent background must remain transparent.', relatedLabel: 'Related tools and guides', action: 'Open', related: [['Resize image', 'Set an exact output canvas after choosing the crop.', '/resize-image/'], ['Image size checker', 'Check the source dimensions before choosing coordinates.', '/image-size-checker/'], ['Compress without changing dimensions', 'Keep output pixels fixed when only the byte limit needs attention.', '/blog/compress-without-changing-dimensions/']] },
    size: { heading: 'Read the file before changing it', methodLabel: 'What the checker reports', method: 'The checker reads the selected file’s exact bytes, decimal KB, binary KiB, decoded pixel dimensions, aspect ratio, and the available transparency indication.', limitLabel: 'Known limits', limitation: 'File bytes and pixel dimensions measure different things. A smaller byte count does not necessarily mean fewer pixels, and a file that fits one upload limit may still fail another service’s format rule.', relatedLabel: 'Related tools and guides', action: 'Open', related: [['Compress image', 'Set a byte budget after checking the source.', '/compress-image/'], ['DPI checker', 'Read print-resolution metadata when the image contains it.', '/image-dpi-checker/'], ['KB vs KiB', 'Choose the same unit used by the destination.', '/blog/kb-vs-kib/']] },
    dpi: { heading: 'Understand what DPI can tell you', methodLabel: 'What the checker reports', method: 'The checker reads supported density metadata when it is present and shows the decoded pixel dimensions separately. It reports missing DPI as not embedded rather than assuming 72 DPI.', limitLabel: 'Known limits', limitation: 'DPI metadata does not create image detail or prove a print will be accepted. The receiving printer or service determines its required physical size, pixels, format, and color handling.', relatedLabel: 'Related tools and guides', action: 'Open', related: [['Image size checker', 'Read exact bytes and pixel dimensions.', '/image-size-checker/'], ['Resize image', 'Change the pixel grid when a workflow requires it.', '/resize-image/'], ['Check image size, pixels, and DPI', 'Learn how bytes, pixels, and DPI differ.', '/blog/check-image-size-and-dpi/']] }
  },
  'zh-cn': {
    compress: { heading: '导出前请确认', methodLabel: '工具会检查什么', method: '压缩工具将所选目标作为字节预算。生成文件后会先检查 Blob 的实际大小，再显示下载链接；是否成功不取决于四舍五入后的 KB 标签。', limitLabel: '已知限制', limitation: '保持原始尺寸时，目标可能无法达到。PNG 为无损格式；照片和带透明背景的图片，通常会比相近尺寸的 JPEG 或 WebP 需要更多字节。', relatedLabel: '相关工具与指南', action: '打开', related: [['检查文件大小和像素', '选目标前先查看源文件。', '/image-size-checker/'], ['缩放图片', '接收方允许时再降低像素尺寸。', '/resize-image/'], ['为什么图片可能无法压到 50 KB？', '了解细节、透明度和格式为何影响结果。', '/blog/why-image-wont-fit-50kb/']] },
    resize: { heading: '选择合适的缩放方式', methodLabel: '三种模式的区别', method: '适配会完整显示图片，并在输出格式支持时留下空白区域；填充会覆盖目标画布并裁去居中的边缘；拉伸会使用确切宽高，因而改变图片比例。', limitLabel: '已知限制', limitation: '改变像素尺寸并不保证特定文件大小或打印效果。提交前请检查导出的尺寸，以及接收平台对格式的要求。', relatedLabel: '相关工具与指南', action: '打开', related: [['裁剪图片', '选择要保留的确切画面。', '/crop-image/'], ['图片大小检查', '确认像素、字节和宽高比。', '/image-size-checker/'], ['如何检查图片大小、像素与 DPI？', '了解上传或打印时应该查看哪一项。', '/blog/check-image-size-and-dpi/']] },
    crop: { heading: '使用精确坐标裁剪', methodLabel: '选区如何工作', method: '在预览区拖动会创建像素裁剪框。导出前，可通过数值字段微调左侧、顶部、宽度和高度。', limitLabel: '已知限制', limitation: '导出文件会永久排除选区外的像素。若必须保留透明背景，请选择 PNG 或 WebP。', relatedLabel: '相关工具与指南', action: '打开', related: [['缩放图片', '选好裁剪范围后设置准确的输出画布。', '/resize-image/'], ['图片大小检查', '设置坐标前先检查源图尺寸。', '/image-size-checker/'], ['不改变像素尺寸，如何压缩图片？', '只需处理字节限制时保持输出像素不变。', '/blog/compress-without-changing-dimensions/']] },
    size: { heading: '修改前先读取文件', methodLabel: '检查器会显示什么', method: '检查器会读取所选文件的精确字节数、十进制 KB、二进制 KiB、解码后的像素尺寸、宽高比和可用的透明度信息。', limitLabel: '已知限制', limitation: '文件字节数和像素尺寸是不同的度量。字节数更小不一定代表像素更少；符合一个平台的体积限制也不等于符合另一个平台的格式规则。', relatedLabel: '相关工具与指南', action: '打开', related: [['压缩图片', '检查源文件后设置字节预算。', '/compress-image/'], ['DPI 检查', '图片包含时读取打印分辨率元数据。', '/image-dpi-checker/'], ['KB 与 KiB 有什么区别？', '使用接收平台标明的单位。', '/blog/kb-vs-kib/']] },
    dpi: { heading: '了解 DPI 能说明什么', methodLabel: '检查器会显示什么', method: '检查器会在图片包含支持的密度元数据时读取它，并单独显示解码后的像素尺寸。没有 DPI 时会显示未嵌入，不会假定为 72 DPI。', limitLabel: '已知限制', limitation: 'DPI 元数据不会增加图片细节，也不能证明打印一定会通过。打印机或接收平台会决定实际所需的物理尺寸、像素、格式和颜色处理。', relatedLabel: '相关工具与指南', action: '打开', related: [['图片大小检查', '查看精确字节数和像素尺寸。', '/image-size-checker/'], ['缩放图片', '工作流程需要时调整像素网格。', '/resize-image/'], ['如何检查图片大小、像素与 DPI？', '了解字节、像素和 DPI 的区别。', '/blog/check-image-size-and-dpi/']] }
  },
  'zh-tw': {
    compress: { heading: '匯出前請確認', methodLabel: '工具會檢查什麼', method: '壓縮工具將所選目標作為位元組預算。產生檔案後會先檢查 Blob 的實際大小，再顯示下載連結；是否成功不取決於四捨五入後的 KB 標示。', limitLabel: '已知限制', limitation: '保留原始尺寸時，目標可能無法達到。PNG 為無損格式；照片和帶透明背景的圖片，通常會比相近尺寸的 JPEG 或 WebP 需要更多位元組。', relatedLabel: '相關工具與指南', action: '開啟', related: [['檢查檔案大小和像素', '選擇目標前先查看來源檔案。', '/image-size-checker/'], ['縮放圖片', '接收方允許時再降低像素尺寸。', '/resize-image/'], ['為什麼圖片可能無法壓到 50 KB？', '了解細節、透明度和格式為何影響結果。', '/blog/why-image-wont-fit-50kb/']] },
    resize: { heading: '選擇合適的縮放方式', methodLabel: '三種模式的差異', method: '符合會完整顯示圖片，並在輸出格式支援時留下空白區域；填滿會覆蓋目標畫布並裁去置中的邊緣；拉伸會使用確切寬高，因而改變圖片比例。', limitLabel: '已知限制', limitation: '改變像素尺寸並不保證特定檔案大小或列印效果。提交前請檢查匯出的尺寸，以及接收平台對格式的要求。', relatedLabel: '相關工具與指南', action: '開啟', related: [['裁切圖片', '選擇要保留的確切畫面。', '/crop-image/'], ['圖片大小檢查', '確認像素、位元組和長寬比。', '/image-size-checker/'], ['如何檢查圖片大小、像素與 DPI？', '了解上傳或列印時應查看哪一項。', '/blog/check-image-size-and-dpi/']] },
    crop: { heading: '使用精確座標裁切', methodLabel: '選取範圍如何運作', method: '在預覽區拖曳會建立像素裁切框。匯出前，可透過數值欄位微調左側、頂端、寬度和高度。', limitLabel: '已知限制', limitation: '匯出檔案會永久排除選取範圍外的像素。若必須保留透明背景，請選擇 PNG 或 WebP。', relatedLabel: '相關工具與指南', action: '開啟', related: [['縮放圖片', '選好裁切範圍後設定準確的輸出畫布。', '/resize-image/'], ['圖片大小檢查', '設定座標前先檢查來源圖片尺寸。', '/image-size-checker/'], ['不改變像素尺寸，如何壓縮圖片？', '只需處理位元組限制時保持輸出像素不變。', '/blog/compress-without-changing-dimensions/']] },
    size: { heading: '修改前先讀取檔案', methodLabel: '檢查器會顯示什麼', method: '檢查器會讀取所選檔案的精確位元組數、十進位 KB、二進位 KiB、解碼後的像素尺寸、長寬比和可用的透明度資訊。', limitLabel: '已知限制', limitation: '檔案位元組數和像素尺寸是不同的測量方式。位元組數較小不一定代表像素較少；符合一個平台的容量限制也不等於符合另一個平台的格式規定。', relatedLabel: '相關工具與指南', action: '開啟', related: [['壓縮圖片', '檢查來源檔案後設定位元組預算。', '/compress-image/'], ['DPI 檢查', '圖片包含時讀取列印解析度中繼資料。', '/image-dpi-checker/'], ['KB 與 KiB 有什麼不同？', '使用接收平台標示的單位。', '/blog/kb-vs-kib/']] },
    dpi: { heading: '了解 DPI 能說明什麼', methodLabel: '檢查器會顯示什麼', method: '檢查器會在圖片包含支援的密度中繼資料時讀取它，並另外顯示解碼後的像素尺寸。沒有 DPI 時會顯示未嵌入，不會假定為 72 DPI。', limitLabel: '已知限制', limitation: 'DPI 中繼資料不會增加圖片細節，也不能證明列印一定會通過。印表機或接收平台會決定實際所需的實體尺寸、像素、格式和顏色處理。', relatedLabel: '相關工具與指南', action: '開啟', related: [['圖片大小檢查', '查看精確位元組數和像素尺寸。', '/image-size-checker/'], ['縮放圖片', '工作流程需要時調整像素網格。', '/resize-image/'], ['如何檢查圖片大小、像素與 DPI？', '了解位元組、像素和 DPI 的差異。', '/blog/check-image-size-and-dpi/']] }
  }
};
const copy = content[locale as 'en' | 'zh-cn' | 'zh-tw'][tool];
---

<section class="tool-support" aria-label={copy.heading}>
  <h2>{copy.heading}</h2>
  <div class="tool-support-grid">
    <section><h3>{copy.methodLabel}</h3><p>{copy.method}</p></section>
    <section><h3>{copy.limitLabel}</h3><p>{copy.limitation}</p></section>
  </div>
  <section class="tool-related"><h3>{copy.relatedLabel}</h3><div>{copy.related.map(([title, text, href]) => <a href={`${prefix}${href}`}><strong>{title}</strong><span>{text}</span><small>{copy.action} <span aria-hidden="true">→</span></small></a>)}</div></section>
</section>
