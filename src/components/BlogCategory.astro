---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guides, type PublishedLocale } from '../lib/guide-content';
import { guideWorkflows } from '../lib/guide-workflows';
import { articleMeta, blogLabels, localizedBlogPath } from '../lib/blog-system';

interface Props { locale: PublishedLocale; category: 'tutorials' | 'troubleshooting'; }
const { locale, category } = Astro.props;
const copy = blogLabels[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
const categoryTitle = category === 'tutorials' ? copy.tutorials : copy.troubleshooting;
const categoryIntro = locale === 'en'
  ? category === 'tutorials' ? 'Step-by-step browser workflows for changing an image and checking the file you keep.' : 'Practical checks for the cases where a file still misses a size, format, or transparency requirement.'
  : locale === 'zh-cn'
    ? category === 'tutorials' ? '围绕图片处理和保存文件的浏览器操作步骤。' : '针对文件体积、格式或透明度不符合要求时的实际排查。'
    : category === 'tutorials' ? '圍繞圖片處理與儲存檔案的瀏覽器操作步驟。' : '針對檔案大小、格式或透明度不符合要求時的實際排查。';
const articles = guides[locale].filter((article) => articleMeta(article.slug).categorySlug === category);
---

<BaseLayout locale={locale} title={categoryTitle} description={categoryIntro}>
  <div class="blog-directory blog-category-page">
    <header class="blog-directory-header">
      <div class="article-breadcrumb"><a href={localizedBlogPath(locale)}>{copy.journal}</a><span aria-hidden="true">/</span><span>{categoryTitle}</span></div>
      <p class="eyebrow">{copy.journal}</p>
      <h1>{categoryTitle}</h1>
      <p class="blog-directory-dek">{categoryIntro}</p>
      <nav class="blog-topic-nav" aria-label={copy.topics}>
        <a href={localizedBlogPath(locale)}>{copy.allArticles}</a>
        <a class:list={[category === 'tutorials' && 'is-current']} href={`${prefix}/blog/category/tutorials/`}>{copy.tutorials}</a>
        <a class:list={[category === 'troubleshooting' && 'is-current']} href={`${prefix}/blog/category/troubleshooting/`}>{copy.troubleshooting}</a>
      </nav>
    </header>

    <section class="blog-list-section" aria-labelledby="category-articles">
      <div class="blog-section-heading"><div><p class="eyebrow">{categoryTitle}</p><h2 id="category-articles">{articles.length} {locale === 'en' ? 'articles' : locale === 'zh-cn' ? '篇文章' : '篇文章'}</h2></div><a class="text-link" href={localizedBlogPath(locale)}>{copy.back} <span aria-hidden="true">→</span></a></div>
      <div class="blog-card-grid">
        {articles.map((article) => {
          const meta = articleMeta(article.slug);
          const workflow = guideWorkflows[locale][article.slug];
          return <article class="blog-card">
            <a class="blog-card-image" href={`${prefix}/blog/${article.slug}/`} aria-label={article.title}><img src={`/blog-workflows/${locale}/${workflow.image}.png`} alt={workflow.caption} loading="lazy" /></a>
            <div class="blog-card-body">
              <p class="article-kicker">{article.category}</p>
              <h3><a href={`${prefix}/blog/${article.slug}/`}>{article.title}</a></h3>
              <p>{article.intro}</p>
              <div class="article-card-meta"><span>{meta.dateLabel[locale]}</span><span>{meta.readMinutes} {copy.readMinutes}</span></div>
              <a class="text-link" href={`${prefix}/blog/${article.slug}/`}>{copy.read} <span aria-hidden="true">→</span></a>
            </div>
          </article>;
        })}
      </div>
    </section>
  </div>
</BaseLayout>
