    updated: '最後更新：2026年10月11日',
    contact: '聯絡 PixelTokb', copy: '複製信箱地址', copied: '信箱地址已複製', copyFailed: '複製失敗，請手動選取上方地址。',
    contactNote: '這是本站唯一設定的聯絡地址。請勿傳送密碼、身分證件、付款資訊或機密圖片。',
    googleHeading: 'Google 廣告資訊', partner: 'Google 如何使用合作夥伴網站的資料', ads: '管理 Google 廣告設定'
  }
}[locale];
---
<div class="page-content">
  <div class="hero"><p class="eyebrow">PIXELTOKB · {locale === 'en' ? 'SITE INFORMATION' : locale === 'zh-cn' ? '站点信息' : '網站資訊'}</p><h1>{title}</h1><p>{intro}</p></div>
  {datedSlugs.has(slug) && <p class="policy-date">{labels.updated}</p>}
  {slug === 'contact' && <section class="contact-channel" aria-labelledby="contact-channel-title">
    <h2 id="contact-channel-title">{labels.contact}</h2>
    <a class="contact-email" href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
    <button type="button" class="copy-email" data-email={siteConfig.contactEmail} data-copied={labels.copied} data-failed={labels.copyFailed}>{labels.copy}</button>
    <p>{labels.contactNote}</p>
    <p class="copy-status" aria-live="polite"></p>
  </section>}
  {slug === 'changelog' ? <div class="changelog-groups">
    {changelogGroups.map((group) => <section class="changelog-group" aria-labelledby={`changelog-${group.date}`}>
      <h2 class="changelog-date" id={`changelog-${group.date}`}>{group.date}</h2>
      <div class="changelog-group-content">
        {group.categories.map((category) => <section class="changelog-category" aria-labelledby={`changelog-${group.date}-${category.name}`}>
          <h3 id={`changelog-${group.date}-${category.name}`}>{category.name}</h3>
          <ul class="changelog-entries">
            {category.entries.map((entry) => <li class="changelog-entry">
              <p><a href={`${prefix}${entry.href}`}>{entry.feature}</a><span aria-hidden="true"> — </span><span>{entry.text}</span></p>
            </li>)}
          </ul>
        </section>)}
      </div>
    </section>)}
  </div> : <div class="foundation-grid">{items.map(([heading, text]) => <section class="foundation-card"><h2>{heading}</h2><p>{text}</p></section>)}</div>}
  {googlePolicySlugs.has(slug) && <section class="policy-links" aria-labelledby="google-policy-links">
    <h2 id="google-policy-links">{labels.googleHeading}</h2>
    <a href="https://policies.google.com/technologies/partner-sites" rel="noopener noreferrer">{labels.partner} <span aria-hidden="true">↗</span></a>
    <a href="https://adssettings.google.com/" rel="noopener noreferrer">{labels.ads} <span aria-hidden="true">↗</span></a>
  </section>}
  {slug !== 'changelog' && <div class="foundation-next"><a href={`${prefix}/tools/`}>{locale === 'en' ? 'Explore image tools' : locale === 'zh-cn' ? '浏览图片工具' : '瀏覽圖片工具'} <span aria-hidden="true">→</span></a><a href={`${prefix}/blog/`}>{locale === 'en' ? 'Read the guides' : locale === 'zh-cn' ? '阅读图片指南' : '閱讀圖片指南'} <span aria-hidden="true">→</span></a></div>}
</div>

{slug === 'contact' && <script>
  document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach((button) => {
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector<HTMLElement>('.copy-status');
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
        if (status) status.textContent = button.dataset.copied ?? '';
      } catch {
        if (status) status.textContent = button.dataset.failed ?? '';
      }
    });
  });
</script>}
