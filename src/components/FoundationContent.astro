---
import siteConfig from '../../config/site.json';
type Locale = 'en' | 'zh-cn' | 'zh-tw';
interface Props { locale: Locale; slug: string; title: string; intro: string; }
const { locale, slug, title, intro } = Astro.props;
type Section = [string, string];
const sections: Record<Locale, Record<string, Section[]>> = {
  en: {
    about: [['Operator and purpose', 'PixelTokb operates this independent image-utility site. It is not affiliated with Google, upload portals, government agencies, printers, or device manufacturers.'], ['Available tools', 'The published tools compress JPEG, PNG, and WebP files to byte targets, resize pixel dimensions, crop a selected region, and inspect file size, dimensions, transparency, and available DPI metadata.'], ['Local processing', 'Image files are decoded and processed in your browser. PixelTokb does not receive the selected image, create an account, or store a cloud copy of the result.'], ['Limits', 'A successful export does not guarantee that another service will accept the file or that it is suitable for printing. Users must check the destination’s format, dimensions, byte limit, and content rules.'], ['Funding and independence', 'Advertising is currently disabled. If advertising is activated after consent and policy checks, it will not change tool results or require an ad click to download.']],
    contact: [['Email channel', 'PixelTokb provides one email channel for content corrections, privacy requests, accessibility issues, and site feedback. There is no contact form, account inbox, live chat, or telephone support.'], ['What to include', 'Describe the page or tool, the issue, and the result you expected. Do not attach confidential images or send passwords, identity documents, payment information, or other sensitive data.'], ['Response and safety', 'Sending email does not create a professional, fiduciary, or emergency-service relationship. Delivery and response times are not guaranteed; urgent or emergency matters should use an appropriate local service.']],
    privacy: [['Scope and controller', 'PixelTokb is responsible for the site-level processing described here. Questions and rights requests may be sent to the contact address shown on this page.'], ['Images and tool results', 'Selected images are decoded and processed locally in the browser. PixelTokb does not upload them, create public result URLs, or keep server copies. Closing or refreshing the page removes in-memory selections and Blob results.'], ['Browser preferences', 'The site uses localStorage keys for theme and interface-language preferences. These values stay in the browser until changed or cleared; uploaded images are not stored in localStorage.'], ['Hosting data', 'The hosting and network providers may process ordinary request data such as IP address, requested URL, time, user agent, security events, and diagnostic logs to deliver and protect the site. Retention and international processing depend on the verified production provider and its settings.'], ['Email', 'If you email PixelTokb, the message, address, attachments, and delivery metadata are processed to answer the request, prevent abuse, keep necessary records, or meet legal obligations. Do not send sensitive images or credentials.'], ['Advertising and consent', 'Advertising and non-essential analytics are currently off. If Google advertising is enabled later, Google and approved partners may use cookies, web beacons, IP addresses, or other identifiers for delivery, measurement, fraud prevention, and—only where permitted and consented—personalization. A certified consent platform and preference-revocation entry must be active where required before ad requests are sent.'], ['Choices and rights', 'You can clear local preferences in browser settings and may ask PixelTokb about site-level personal data by email. Google advertising choices, if ads are later enabled, are managed through the consent interface and Google Ads Settings. Mandatory rights vary by location and are not limited by this policy.'], ['Children and changes', 'The site is a general-audience utility and is not directed to children. Material policy changes will be recorded with an updated date; continued use after a change is subject to mandatory law.']],
    terms: [['Who operates the service', 'PixelTokb provides the site and its browser-based image tools. These terms apply to site use; third-party upload services, printers, browsers, and device platforms have their own terms.'], ['Permitted use', 'Use the tools only with files you own or are authorized to process, and only for lawful purposes. Do not use the site to infringe rights, distribute unlawful material, attack the service, bypass limits, or mislead others about an image.'], ['Your files and privacy', 'You keep responsibility for your source files and downloaded results. Image processing occurs locally, but you should still use a trusted device and browser and keep your own backups.'], ['Results and technical limits', 'Compression can reduce visual quality; resizing and cropping permanently change pixels; DPI metadata does not create image detail. PixelTokb verifies stated output properties where described but does not guarantee third-party acceptance, print quality, uninterrupted availability, or compatibility with every browser.'], ['No professional advice', 'Tool output and articles provide general technical information, not legal, medical, financial, identity, immigration, printing, or other professional advice. Confirm official requirements with the organization receiving the file.'], ['Responsibility and liability', 'You are responsible for your input, chosen settings, use of results, and compliance with destination rules. To the maximum extent allowed by applicable law, PixelTokb is not liable for indirect or consequential loss, lost submissions, lost data, or decisions made by third parties. Nothing here excludes liability or consumer rights that cannot lawfully be excluded.'], ['Availability and changes', 'PixelTokb may correct, update, suspend, or remove features for security, reliability, policy, or legal reasons. Material changes are recorded in the changelog or policy pages.']],
    cookies: [['Current storage', 'PixelTokb currently uses localStorage for theme and language preferences. It does not currently set an advertising cookie, run non-essential analytics, or store uploaded images in browser storage.'], ['Essential delivery data', 'The browser and hosting provider may use technically necessary network or security mechanisms to deliver pages and prevent abuse. These are separate from optional advertising personalization.'], ['Advertising status', 'Google advertising is off. If enabled later, Google and approved vendors may place or read cookies and use web beacons, IP addresses, or other identifiers for ad delivery, measurement, fraud prevention, and permitted personalization.'], ['Consent before advertising', 'Where consent is legally required, advertising and related storage must remain blocked until a valid choice is recorded through a Google-certified consent platform. Users must be able to refuse, manage, and later withdraw their choice without losing access to the image tools.'], ['Manage choices', 'Theme and language can be changed in the header or cleared in browser settings. If advertising is enabled, a persistent privacy-preference entry will reopen the consent controls; Google ad personalization can also be managed in Google Ads Settings.']],
    'editorial-policy': [['Publisher and reviewer', 'PixelTokb is the publisher. The PixelTokb editorial team is the named reviewer responsible for the published guides and policy pages.'], ['Evidence standard', 'Technical claims are checked with real image files, saved downloads, exact bytes, decoded dimensions, MIME signatures, transparency, and failure paths. Measured examples state their method and do not imply that every image or browser will produce the same result.'], ['Original and assisted work', 'Articles are written for PixelTokb and may use software or AI assistance for drafting, translation, or checking. PixelTokb reviews the final structure, facts, examples, limitations, links, and language versions; automatically generated text is not published without review.'], ['Corrections and updates', 'Readers may report errors by email. PixelTokb evaluates corrections against reproducible evidence, updates material errors, and records meaningful product or policy changes in the changelog.'], ['Commercial independence', 'Advertising, if enabled later, does not buy favorable coverage, alter tool results, or replace editorial review. Ads must remain visually separate from navigation, upload, processing, and download controls.']],
    'how-it-works': [['Choose a target', 'Select a range or enter a custom KB, KiB, MB, or MiB value. The tool converts that value to an exact byte budget.'], ['Process locally', 'A browser Worker reads and re-encodes the image. The result is only offered when its actual Blob size meets the selected budget.'], ['Know the limits', 'PixelTokb accepts static JPEG, PNG, and WebP files up to 20 MB and checks decoded dimensions against a 40-megapixel limit. Animated files are not supported.']],
    faq: [['What is the difference between KB and KiB?', 'KB is 1,000 bytes; KiB is 1,024 bytes. MB is 1,000,000 bytes; MiB is 1,048,576 bytes. Choose the unit required by your destination.'], ['Why can a target be unreachable?', 'The chosen format, image details, and any requirement to keep the original dimensions can prevent a file from fitting under a small limit.'], ['Are my images uploaded?', 'The current image tools run in the browser and do not send the selected image to a pixeltokb server.']],
  },
  'zh-cn': {
    about: [['运营者与用途', 'PixelTokb 运营这个独立图片工具网站，与 Google、上传平台、政府机构、打印服务或设备厂商不存在隶属或背书关系。'], ['当前可用工具', '已发布工具可以按字节目标压缩 JPEG、PNG、WebP，调整像素尺寸、裁剪区域，并检查文件大小、像素、透明度和可用 DPI 元数据。'], ['本地处理', '图片在浏览器中解码和处理。PixelTokb 不接收所选图片、不要求账号，也不会在云端保存结果副本。'], ['能力边界', '成功导出不代表第三方平台一定接受，也不代表适合印刷。用户需要核对接收方的格式、像素、字节上限和内容规则。'], ['资金与独立性', '广告目前关闭。以后只有在同意和政策检查通过后才可能启用，广告不会改变工具结果，也不会要求用户点击广告才能下载。']],
    contact: [['电子邮件渠道', 'PixelTokb 提供一个电子邮件渠道，用于内容纠错、隐私请求、无障碍问题和网站反馈。本站没有联系表单、账号收件箱、在线客服或电话支持。'], ['来信内容', '请说明页面或工具、遇到的问题及预期结果。不要发送机密图片、密码、身份证件、支付信息或其他敏感数据。'], ['响应与安全', '发送邮件不会建立专业顾问、受托或紧急服务关系，也不保证送达或回复时限。紧急事项应联系所在地的适当服务机构。']],
    privacy: [['适用范围与责任方', 'PixelTokb 负责本政策说明的站点级数据处理。隐私问题和权利请求可发送到本页显示的联系地址。'], ['图片与工具结果', '所选图片只在浏览器本地解码和处理。PixelTokb 不上传图片、不生成公开结果链接，也不保存服务器副本。关闭或刷新页面会清除内存中的选择和 Blob 结果。'], ['浏览器偏好', '本站使用 localStorage 保存主题和界面语言偏好，直到用户修改或清除；上传图片不会写入 localStorage。'], ['托管访问数据', '托管和网络服务商可能处理 IP 地址、请求网址、时间、用户代理、安全事件和诊断日志等常规请求数据，用于提供和保护站点。保存期限与跨境处理取决于经验证的生产服务商及其配置。'], ['电子邮件', '用户发送邮件时，PixelTokb 会处理邮件地址、正文、附件和投递元数据，用于回复、阻止滥用、保留必要记录或履行法律义务。请勿发送敏感图片或登录凭据。'], ['广告与同意', '广告和非必要分析目前关闭。如果以后启用 Google 广告，Google 和获准合作方可能使用 Cookie、网络信标、IP 地址或其他标识符进行投放、衡量、防欺诈，以及在获得允许和有效同意时进行个性化。依法需要同意的地区，在发送广告请求前必须启用认证同意平台和撤回入口。'], ['选择与权利', '用户可以在浏览器设置中清除本地偏好，也可以通过邮件查询 PixelTokb 处理的站点级个人数据。启用广告后，广告选择通过同意界面和 Google 广告设置管理。不同地区的强制权利不受本政策限制。'], ['儿童与变更', '本站是面向一般用户的工具，并非专门面向儿童。重要政策变化会标注更新日期；法律另有强制规定的，从其规定。']],
    terms: [['服务提供方', 'PixelTokb 提供本站及浏览器图片工具。本条款只适用于本站；第三方上传平台、打印服务、浏览器和设备平台有各自条款。'], ['允许用途', '只能处理你拥有或获授权处理的文件，并用于合法目的。不得侵权、传播违法内容、攻击服务、绕过限制，或利用处理结果误导他人。'], ['你的文件与隐私', '源文件和下载结果由用户自行负责。图片在本地处理，但仍应使用可信设备和浏览器，并自行保留备份。'], ['结果与技术限制', '压缩可能降低画质，缩放和裁剪会永久改变像素，DPI 元数据不会增加细节。PixelTokb 会核验页面明确说明的输出属性，但不保证第三方接受、打印质量、服务不中断或兼容所有浏览器。'], ['非专业建议', '工具结果和文章只提供一般技术信息，不构成法律、医疗、金融、身份、移民、打印或其他专业建议。请向接收文件的机构核实官方要求。'], ['责任边界', '用户对输入文件、所选设置、结果用途及遵守接收方规则负责。在适用法律允许的最大范围内，PixelTokb 不承担间接或后果性损失、申请失败、数据丢失或第三方决定造成的损失。本条款不排除法律不得排除的责任或消费者权利。'], ['服务变化', 'PixelTokb 可因安全、可靠性、政策或法律原因修正、更新、暂停或移除功能。重要变化会记录在更新记录或政策页面。']],
    cookies: [['当前存储', 'PixelTokb 目前使用 localStorage 保存主题和语言偏好，不设置广告 Cookie、不运行非必要分析，也不在浏览器存储中保存上传图片。'], ['必要的交付数据', '浏览器和托管服务商可能使用交付页面和防止滥用所必需的网络或安全机制，这与可选的广告个性化不同。'], ['广告状态', 'Google 广告目前关闭。以后启用时，Google 和获准供应商可能放置或读取 Cookie，并使用网络信标、IP 地址或其他标识符进行广告投放、衡量、防欺诈和获准的个性化。'], ['广告前的同意', '依法需要同意的地区，在认证同意平台记录有效选择前，广告及相关存储必须保持阻止。用户必须能够拒绝、管理并在之后撤回选择，且拒绝不会导致图片工具不可用。'], ['管理选择', '主题与语言可以在页头修改，也可以通过浏览器设置清除。启用广告后，站点会提供持续可用的隐私偏好入口重新打开同意控件；广告个性化也可在 Google 广告设置中管理。']],
    'editorial-policy': [['发布方与审核方', 'PixelTokb 是内容发布方，具名审核方为 PixelTokb 编辑团队，对已发布指南和政策页承担编辑责任。'], ['证据标准', '技术说法使用真实图片、落盘下载、精确字节、解码尺寸、MIME 签名、透明度和失败路径核验。实测样例会说明方法，不暗示每张图片或每种浏览器都会得到相同结果。'], ['原创与辅助工具', '文章为 PixelTokb 编写，起草、翻译或检查过程中可能使用软件或 AI 辅助。PixelTokb 会审核最终结构、事实、样例、限制、链接和语言版本，不发布未经审核的自动生成文本。'], ['纠错与更新', '读者可以通过邮件报告错误。PixelTokb 根据可复现证据评估并修正重大错误，并在更新记录中记录有意义的产品或政策变化。'], ['商业独立性', '未来如启用广告，广告不会购买正面评价、改变工具结果或替代编辑审核。广告必须与导航、上传、处理和下载控件保持清晰分隔。']],
    'how-it-works': [['选择目标', '选择一个规格区间，或自定义 KB、KiB、MB、MiB 数值。工具会将其换算为精确的字节预算。'], ['本地处理', '浏览器 Worker 读取并重新编码图片。只有输出 Blob 的真实大小符合目标，才提供下载。'], ['了解限制', 'PixelTokb 接受最大 20 MB、解码后不超过 4000 万像素的静态 JPEG、PNG 和 WebP 图片，不支持动态图片。']],
    faq: [['KB 和 KiB 有什么区别？', 'KB 为 1000 字节，KiB 为 1024 字节；MB 为 100 万字节，MiB 为 1048576 字节。请选择接收平台使用的单位。'], ['为什么可能无法达到目标？', '所选格式、图片细节及保持原始像素尺寸的要求，可能让文件无法降到较小的体积上限。'], ['图片会上传吗？', '当前图片工具在浏览器本地运行，不会将所选图片发送到 pixeltokb 服务器。']],
  },
  'zh-tw': {
    about: [['營運者與用途', 'PixelTokb 營運這個獨立圖片工具網站，與 Google、上傳平台、政府機構、列印服務或裝置廠商沒有隸屬或背書關係。'], ['目前可用工具', '已發布工具可依位元組目標壓縮 JPEG、PNG、WebP，調整像素尺寸、裁切區域，並檢查檔案大小、像素、透明度及可用 DPI 中繼資料。'], ['本機處理', '圖片在瀏覽器中解碼與處理。PixelTokb 不接收所選圖片、不要求帳號，也不會在雲端保留結果副本。'], ['功能界線', '成功匯出不代表第三方平台一定接受，也不代表適合列印。使用者需要核對接收方的格式、像素、位元組上限與內容規則。'], ['資金與獨立性', '廣告目前停用。日後只有在同意與政策檢查通過後才可能啟用，廣告不會改變工具結果，也不會要求使用者點擊廣告才能下載。']],
    contact: [['電子郵件管道', 'PixelTokb 提供一個電子郵件管道，用於內容更正、隱私請求、無障礙問題與網站意見。本站沒有聯絡表單、帳號收件匣、線上客服或電話支援。'], ['來信內容', '請說明頁面或工具、遇到的問題及預期結果。請勿傳送機密圖片、密碼、身分證件、付款資訊或其他敏感資料。'], ['回覆與安全', '寄送郵件不會建立專業顧問、受託或緊急服務關係，也不保證送達或回覆時間。緊急事項應聯絡所在地的適當服務機構。']],
    privacy: [['適用範圍與責任方', 'PixelTokb 負責本政策說明的網站層級資料處理。隱私問題與權利請求可寄至本頁顯示的聯絡地址。'], ['圖片與工具結果', '所選圖片只在瀏覽器本機解碼與處理。PixelTokb 不上傳圖片、不建立公開結果連結，也不保存伺服器副本。關閉或重新整理頁面會清除記憶體中的選擇與 Blob 結果。'], ['瀏覽器偏好', '本站使用 localStorage 儲存主題與介面語言偏好，直到使用者修改或清除；上傳圖片不會寫入 localStorage。'], ['託管存取資料', '託管與網路服務商可能處理 IP 位址、請求網址、時間、使用者代理、安全事件及診斷紀錄等一般請求資料，用於提供與保護網站。保存期限與跨境處理取決於經驗證的正式服務商及其設定。'], ['電子郵件', '使用者寄送郵件時，PixelTokb 會處理信箱、內文、附件及投遞中繼資料，用於回覆、防止濫用、保留必要紀錄或履行法律義務。請勿傳送敏感圖片或登入憑證。'], ['廣告與同意', '廣告與非必要分析目前停用。日後若啟用 Google 廣告，Google 與獲准合作方可能使用 Cookie、網路信標、IP 位址或其他識別碼進行投放、衡量、防詐騙，以及在取得允許與有效同意時進行個人化。依法需要同意的地區，在傳送廣告請求前必須啟用認證同意平台與撤回入口。'], ['選擇與權利', '使用者可以在瀏覽器設定中清除本機偏好，也可以透過郵件查詢 PixelTokb 處理的網站層級個人資料。啟用廣告後，廣告選擇透過同意介面與 Google 廣告設定管理。不同地區的強制權利不受本政策限制。'], ['兒童與變更', '本站是一般使用者工具，並非專門面向兒童。重要政策變更會標示更新日期；法律另有強制規定者，從其規定。']],
    terms: [['服務提供方', 'PixelTokb 提供本站與瀏覽器圖片工具。本條款只適用於本站；第三方上傳平台、列印服務、瀏覽器及裝置平台有各自條款。'], ['允許用途', '只能處理你擁有或獲授權處理的檔案，並用於合法目的。不得侵權、散布違法內容、攻擊服務、規避限制，或利用處理結果誤導他人。'], ['你的檔案與隱私', '來源檔案與下載結果由使用者自行負責。圖片在本機處理，但仍應使用可信裝置與瀏覽器，並自行保留備份。'], ['結果與技術限制', '壓縮可能降低畫質，縮放與裁切會永久改變像素，DPI 中繼資料不會增加細節。PixelTokb 會查核頁面明確說明的輸出屬性，但不保證第三方接受、列印品質、服務不中斷或相容所有瀏覽器。'], ['非專業建議', '工具結果與文章只提供一般技術資訊，不構成法律、醫療、金融、身分、移民、列印或其他專業建議。請向接收檔案的機構確認官方要求。'], ['責任界線', '使用者對輸入檔案、所選設定、結果用途及遵守接收方規則負責。在適用法律允許的最大範圍內，PixelTokb 不承擔間接或後果性損失、申請失敗、資料遺失或第三方決定造成的損失。本條款不排除法律不得排除的責任或消費者權利。'], ['服務變更', 'PixelTokb 可因安全、可靠性、政策或法律原因修正、更新、暫停或移除功能。重要變更會記錄於更新記錄或政策頁面。']],
