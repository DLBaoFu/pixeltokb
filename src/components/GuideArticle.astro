---
import BaseLayout from '../layouts/BaseLayout.astro';
import { type PublishedLocale } from '../lib/guide-content';
import { blogArticleMeta, blogGuides, blogWorkflow } from '../lib/blog-content';
import { blogLabels, localizedBlogPath } from '../lib/blog-system';

interface Props { locale: PublishedLocale; slug: string; }
const { locale, slug } = Astro.props;
const guides = blogGuides(locale);
const guide = guides.find((item) => item.slug === slug)!;
const workflow = blogWorkflow(locale, slug);
const meta = blogArticleMeta(locale, slug);
const labels = blogLabels[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
const articleIndex = guides.findIndex((item) => item.slug === slug);
const previous = articleIndex > 0 ? guides[articleIndex - 1] : null;
const next = articleIndex < guides.length - 1 ? guides[articleIndex + 1] : null;
const related = guides.filter((item) => item.slug !== slug).slice(0, 2);
const articleImage = new URL(`/blog-workflows/${locale}/${workflow.image}.png`, 'https://www.pixeltokb.com').href;
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.intro,
  image: articleImage,
  datePublished: meta.publishedAt,
  dateModified: meta.publishedAt,
  author: { '@type': 'Organization', name: 'PixelTokb', url: 'https://www.pixeltokb.com/' },
  publisher: { '@type': 'Organization', name: 'PixelTokb', url: 'https://www.pixeltokb.com/' },
  mainEntityOfPage: `https://www.pixeltokb.com${prefix}/blog/${slug}/`
}).replace(/</g, '\\u003c');
---

<BaseLayout locale={locale} title={guide.title} description={guide.intro}>
  <script slot="head" type="application/ld+json" set:html={articleSchema}></script>
  <article class="article-page">
    <header class="article-header">
      <div class="article-breadcrumb"><a href={localizedBlogPath(locale)}>{labels.journal}</a><span aria-hidden="true">/</span><a href={`${prefix}/blog/category/${meta.categorySlug}/`}>{guide.category}</a></div>
      <p class="article-kicker">{guide.category}</p>
      <h1>{guide.title}</h1>
      <p class="article-dek">{guide.intro}</p>
      <div class="article-byline">
        <span class="article-avatar" aria-hidden="true">PT</span>
        <div><strong>{labels.by} PixelTokb</strong><span>{labels.published} <time datetime={meta.publishedAt}>{meta.dateLabel[locale]}</time></span></div>
        <span class="article-reading-time">{meta.readMinutes} {labels.readMinutes}</span>
      </div>
    </header>

    <div class="article-layout">
      <aside class="article-sidebar" aria-label={labels.contents}>
        <div class="article-toc">
          <p>{labels.contents}</p>
          <ol>
            <li><a href="#browser-run">{labels.browserRun}</a></li>
            <li><a href="#verified-result">{labels.result}</a></li>
            {guide.sections.map((section, index) => <li><a href={`#article-section-${index + 1}`}>{section[0]}</a></li>)}
            <li><a href="#result-check">{labels.method}</a></li>
          </ol>
        </div>
        <a class="article-sidebar-link" href={`${prefix}/compress-image/`}>{labels.openTool} <span aria-hidden="true">→</span></a>
      </aside>

      <div class="article-content">
        <section class="article-lead-note guide-situation" id="browser-run">
          <p class="article-note-label">{labels.fieldNote}</p>
          <p>{workflow.situation}</p>
        </section>

        <section class="article-section article-steps-section guide-workflow" aria-labelledby="steps-heading">
          <h2 id="steps-heading">{locale === 'en' ? 'Do this in the browser' : locale === 'zh-cn' ? '浏览器操作流程' : '瀏覽器操作流程'}</h2>
          <ol class="article-steps guide-steps">
            {workflow.steps.map(([step, detail], index) => <li><span class="article-step-number">{index + 1}</span><div><h3>{step}</h3><p>{detail}</p></div></li>)}
          </ol>
        </section>

        <figure class="article-figure guide-screenshot">
          <img src={`/blog-workflows/${locale}/${workflow.image}.png`} alt={workflow.caption} />
          <figcaption>{workflow.caption}</figcaption>
        </figure>

        <section class="article-result example-panel guide-example" id="verified-result" aria-labelledby="result-heading">
          <div class="article-result-heading"><p class="article-note-label">{labels.result}</p><h2 id="result-heading">{guide.example.heading}</h2></div>
          <dl>{guide.example.rows.map(([term, detail]) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
          <p class="article-result-note">{guide.example.note}</p>
        </section>

        {guide.sections.map(([heading, text], index) => <section class="article-section" id={`article-section-${index + 1}`}><h2>{heading}</h2><p>{text}</p></section>)}

        <section class="article-check" id="result-check" aria-labelledby="check-heading">
          <p class="article-note-label">{labels.method}</p>
          <h2 id="check-heading">{labels.method}</h2>
          {guide.sources.map(([heading, text]) => <div><h3>{heading}</h3><p>{text}</p></div>)}
        </section>

        <section class="article-tool-cta"><div><p class="article-note-label">{labels.openTool}</p><h2>{locale === 'en' ? 'Ready to try it?' : locale === 'zh-cn' ? '现在就试一下？' : '現在就試試看？'}</h2></div><a href={`${prefix}/compress-image/`}>{labels.openTool} <span aria-hidden="true">→</span></a></section>

        <section class="article-related" aria-labelledby="related-heading">
          <div class="blog-section-heading"><h2 id="related-heading">{labels.related}</h2><a class="text-link" href={localizedBlogPath(locale)}>{labels.allArticles} <span aria-hidden="true">→</span></a></div>
          <div class="article-related-grid">{related.map((item) => <a href={`${prefix}/blog/${item.slug}/`}><span class="article-kicker">{item.category}</span><h3>{item.title}</h3><p>{item.intro}</p><span class="text-link">{labels.read} <span aria-hidden="true">→</span></span></a>)}</div>
        </section>

        <nav class="article-pagination" aria-label={labels.related}>
          {previous ? <a href={`${prefix}/blog/${previous.slug}/`}><span>{labels.previous}</span><strong>← {previous.title}</strong></a> : <span></span>}
          {next ? <a href={`${prefix}/blog/${next.slug}/`}><span>{labels.next}</span><strong>{next.title} →</strong></a> : <span></span>}
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
