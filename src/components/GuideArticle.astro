---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guides, type PublishedLocale } from '../lib/guide-content';
import { guideWorkflows } from '../lib/guide-workflows';

interface Props { locale: PublishedLocale; slug: string; }
const { locale, slug } = Astro.props;
const guide = guides[locale].find((item) => item.slug === slug)!;
const workflow = guideWorkflows[locale][slug];
const prefix = locale === 'en' ? '' : `/${locale}`;

const labels = {
  en: { use: 'Start with the real upload rule', steps: 'Do this in the browser', proof: 'What this browser run shows', details: 'What changes the outcome', method: 'How this example was checked', next: 'Continue with the tool' },
  'zh-cn': { use: '先从真实上传要求开始', steps: '在浏览器里这样做', proof: '这次浏览器操作显示了什么', details: '哪些地方会改变结果', method: '这个案例是怎样核对的', next: '继续使用工具' },
  'zh-tw': { use: '先從真實上傳要求開始', steps: '在瀏覽器裡這樣做', proof: '這次瀏覽器操作顯示了什麼', details: '哪些地方會改變結果', method: '這個案例如何核對', next: '繼續使用工具' }
}[locale];
---

<BaseLayout locale={locale} title={guide.title} description={guide.intro}>
  <article class="guide-article">
    <div class="hero">
      <p class="eyebrow">{guide.category} · PIXELTOKB</p>
      <h1>{guide.title}</h1>
      <p>{guide.intro}</p>
    </div>

    <section class="guide-situation">
      <h2>{labels.use}</h2>
      <p>{workflow.situation}</p>
    </section>

    <section>
      <h2>{labels.steps}</h2>
      <ol class="guide-steps">
        {workflow.steps.map(([step, detail]) => <li><strong>{step}</strong><span>{detail}</span></li>)}
      </ol>
    </section>

    <figure class="guide-screenshot">
      <img src={`/blog-workflows/${locale}/${workflow.image}.png`} alt={workflow.caption} loading="lazy" />
      <figcaption>{workflow.caption}</figcaption>
    </figure>

    <section class="example-panel">
      <h2>{labels.proof}</h2>
      <dl>{guide.example.rows.map(([term, detail]) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
      <p>{guide.example.note}</p>
    </section>

    <section class="guide-details">
      <h2>{labels.details}</h2>
      {guide.sections.map(([heading, text]) => <div><h3>{heading}</h3><p>{text}</p></div>)}
    </section>

    <section class="guide-sources">
      <h2>{labels.method}</h2>
      {guide.sources.map(([heading, text]) => <div><h3>{heading}</h3><p>{text}</p></div>)}
    </section>

    <section class="guide-next">
      <h2>{labels.next}</h2>
      <div>{workflow.links.map(([label, href]) => <a href={`${prefix}${href}`}>{label} <span aria-hidden="true">→</span></a>)}</div>
    </section>
  </article>
</BaseLayout>
