---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const sections = {
  compress: { title: 'Image compression', intro: 'Choose an exact byte target for JPEG, PNG, or WebP, or use verified lossless optimization for one PNG or a batch of up to 20.', links: [['Lossless PNG optimizer', 'Optimize PNG files locally and download verified smaller results separately or together as a ZIP.', '/compress-png/'], ['Increase JPEG size', 'Meet a minimum byte count with explicit JPEG quality or standard comment padding.', '/increase-image-size/'], ['10–100 KB', 'Small uploads and strict form limits.', '/compress-image/?preset=10-100kb'], ['200–500 KB', 'A practical middle range for photos and documents.', '/compress-image/?preset=200-500kb'], ['500 KB–1 MB', 'Larger images that need a sub-megabyte target.', '/compress-image/?preset=500kb-1mb'], ['2–5 MB', 'Keep more detail under a megabyte-scale limit.', '/compress-image/?preset=2mb-5mb']] },
  resize: { title: 'Resize and crop', intro: 'Plan proportional dimensions, calculate print density, change pixels, crop an image, or prepare a signature image for a real file-size rule.', links: [['Photo resizer', 'Set a print size in millimetres or inches, then verify JPEG or PNG DPI metadata.', '/photo-resizer/'], ['Photo + signature merger', 'Combine a photo and signature into one vertical or horizontal PNG.', '/photo-signature-merger/'], ['Print photo sheet PDF', 'Arrange repeated photos at a physical size on A4 or Letter paper.', '/print-photo-sheet/'], ['Aspect ratio calculator', 'Reduce width and height to a simple ratio and calculate a matching side.', '/aspect-ratio-calculator/'], ['PPI calculator', 'Calculate pixels per inch from a planned print size without changing a file.', '/ppi-calculator/'], ['Resize image', 'Set exact width and height, then choose fit, fill, or stretch.', '/resize-image/'], ['Crop image', 'Select a visual crop area or refine it using pixel coordinates.', '/crop-image/'], ['Signature resizer', 'Crop a signature area, set pixels, and verify the final JPEG byte limit.', '/signature-resizer/'], ['Signature compressor', 'Prepare a white JPEG for a chosen signature upload limit.', '/signature-compressor/'], ['Signature background remover', 'Remove a flat paper or white background with a local colour threshold.', '/signature-background-remover/']] },
  forms: { title: 'Signature and form images', intro: 'Prepare a signature image or a print-size photo locally before an upload, then verify the dimensions and actual file details yourself.', links: [['Signature resizer', 'Crop a signature area, set pixels, and verify the final white JPEG byte limit.', '/signature-resizer/'], ['Signature compressor', 'Prepare a white JPEG for a chosen signature upload limit without sending the image to a server.', '/signature-compressor/'], ['Photo + signature merger', 'Combine a photo and signature before a form upload.', '/photo-signature-merger/'], ['Print photo sheet PDF', 'Create a print-ready sheet with repeated photo copies.', '/print-photo-sheet/'], ['Photo resizer', 'Set a physical size in millimetres or inches and verify the exported JPEG or PNG DPI metadata.', '/photo-resizer/'], ['Image size checker', 'Check bytes, pixel dimensions, format, transparency, and available metadata before upload.', '/image-size-checker/']] },
  inspect: { title: 'Image inspection', intro: 'Check the actual file and print metadata before you upload or send an image.', links: [['Image size checker', 'Inspect bytes, KB and KiB, pixel dimensions, aspect ratio, and transparency.', '/image-size-checker/'], ['DPI checker', 'Read print-resolution metadata when the image contains it.', '/image-dpi-checker/']] }
};
export function getStaticPaths() { return ['compress', 'resize', 'forms', 'inspect'].map((category) => ({ params: { category }, props: { category } })); }
const section = sections[Astro.props.category as keyof typeof sections];
---
<BaseLayout title={section.title} description={section.intro}><div class="directory-page"><div class="hero"><p class="eyebrow">PIXELTOKB · TOOLS</p><h1>{section.title}</h1><p>{section.intro}</p></div><div class="tool-card-grid">{section.links.map(([title, text, href]) => <a class="tool-card" href={href}><span class="directory-icon" aria-hidden="true">✳</span><h2>{title}</h2><p>{text}</p><span class="card-action">Open tool <span aria-hidden="true">→</span></span></a>)}</div><div class="directory-section"><p><a href="/tools/">← All image tools</a></p></div></div></BaseLayout>
