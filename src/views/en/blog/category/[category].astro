---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const categories = {
  tutorials: { title: 'Image tutorials', intro: 'Browser-first workflows: set the task, make one change at a time, and check the file you download.', articles: [['Compress an image without changing its dimensions', 'Keep the pixels, set a byte limit, and verify the saved file.', 'compress-without-changing-dimensions'], ['KB vs KiB: what upload limits really mean', 'Compare the upload rule with the actual saved-byte count.', 'kb-vs-kib'], ['Check image size, pixels, and DPI', 'Check bytes, pixels, and print metadata before you edit.', 'check-image-size-and-dpi'], ['Compress an image to 100 KB for an upload', 'Follow a real 100 KB browser workflow from input to download.', 'compress-image-to-100kb']] },
  troubleshooting: { title: 'Image troubleshooting', intro: 'When the file still misses its target, work out which constraint needs to change before exporting again.', articles: [['Why an image may not fit a 50 KB limit', 'Try the format, pixels, and target in the right order.', 'why-image-wont-fit-50kb']] }
};
export function getStaticPaths() { return ['tutorials', 'troubleshooting'].map((category) => ({ params: { category }, props: { category } })); }
const category = categories[Astro.props.category as keyof typeof categories];
---
<BaseLayout title={category.title} description={category.intro}><div class="directory-page"><div class="hero"><p class="eyebrow">PIXELTOKB · JOURNAL</p><h1>{category.title}</h1><p>{category.intro}</p></div><div class="editorial-grid">{category.articles.map(([title, text, slug]) => <a class="article-card" href={`/blog/${slug}/`}><span class="directory-icon" aria-hidden="true">✳</span><h2>{title}</h2><p>{text}</p><span class="card-action">Read guide <span aria-hidden="true">→</span></span></a>)}</div><div class="directory-section"><p><a href="/blog/">← All guides</a></p></div></div></BaseLayout>
