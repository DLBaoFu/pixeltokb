---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const articles = [
  { slug: 'compress-without-changing-dimensions', category: 'Compression basics', title: 'Compress an image without changing its dimensions', text: 'Keep the pixels, set a byte limit, then check the downloaded file—not just the on-screen estimate.', featured: true },
  { slug: 'why-image-wont-fit-50kb', category: 'Troubleshooting', title: 'Why an image may not fit a 50 KB limit', text: 'When a 50 KB target fails, decide whether the format, the pixels, or the target itself needs to change.' },
  { slug: 'kb-vs-kib', category: 'File size', title: 'KB vs KiB: what upload limits really mean', text: 'A quick way to read the number an upload form means and compare it with the actual saved bytes.' },
  { slug: 'check-image-size-and-dpi', category: 'Image metadata', title: 'Check image size, pixels, and DPI', text: 'Read the file before editing: bytes, pixels, aspect ratio, transparency, and print metadata are different things.' },
  { slug: 'compress-image-to-100kb', category: 'Upload case', title: 'Compress an image to 100 KB for an upload', text: 'Follow a real 100 KB browser run, from choosing the file to checking the generated download.' }
];
---
<BaseLayout title="Image guides and notes" description="Practical image workflows for compression, resizing, cropping, upload limits, pixels, and DPI.">
  <div class="directory-page">
    <div class="hero"><p class="eyebrow">THE PIXELTOKB JOURNAL</p><h1>Use the image tool, then keep the result.</h1><p>Short, practical guides for the moment an upload has a limit: what to click, what to check, and when a different approach is needed.</p></div>
    <div class="category-nav"><a href="/blog/category/tutorials/">Tutorials</a><a href="/blog/category/troubleshooting/">Troubleshooting</a></div>
    <section class="editorial-grid" aria-label="Image guides">{articles.map((article) => <a class:list={['article-card', article.featured && 'featured']} href={`/blog/${article.slug}/`}><span class="directory-icon" aria-hidden="true">{article.featured ? '↘' : '✳'}</span><span class="article-category">{article.category}</span><h2>{article.title}</h2><p>{article.text}</p><span class="card-action">Read guide <span aria-hidden="true">→</span></span></a>)}</section>
    <section class="directory-section"><h2>Use a tool, then read the guide</h2><p>Need to act now? Pick the task. The guides explain the choices that change the file you download.</p><div class="preset-links"><a class="preset-link" href="/compress-image/"><strong>Compress image</strong><span>Set a byte target →</span></a><a class="preset-link" href="/resize-image/"><strong>Resize image</strong><span>Set output pixels →</span></a><a class="preset-link" href="/crop-image/"><strong>Crop image</strong><span>Choose a pixel area →</span></a><a class="preset-link" href="/image-size-checker/"><strong>Check image</strong><span>See bytes and dimensions →</span></a></div></section>
  </div>
</BaseLayout>
