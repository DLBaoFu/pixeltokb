---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompressionTool from '../../components/CompressionTool';
import ResizeTool from '../../components/ResizeTool';
import CropTool from '../../components/CropTool';
import ImageInfoTool from '../../components/ImageInfoTool';
import FoundationContent from '../../components/FoundationContent.astro';
import ToolSupportingContent from '../../components/ToolSupportingContent.astro';
import CompressionRangeNotes from '../../components/CompressionRangeNotes.astro';
import PngOptimizationPage from '../../components/PngOptimizationPage.astro';
import SignatureTool from '../../components/SignatureTool';
import AspectRatioCalculator from '../../components/AspectRatioCalculator';
import PpiCalculator from '../../components/PpiCalculator';
import PhotoResizer from '../../components/PhotoResizer';
import BackgroundRemover from '../../components/BackgroundRemover';
import { compressionGroupForSlug } from '../../lib/compression-groups';
import { pngCopy } from '../../lib/png/content';

export function getStaticPaths() {
  const slugs = ['about', 'contact', 'privacy', 'terms', 'cookies', 'editorial-policy', 'how-it-works', 'faq', 'changelog', 'compress-image', 'compress-png', 'signature-resizer', 'signature-compressor', 'signature-background-remover', 'aspect-ratio-calculator', 'ppi-calculator', 'photo-resizer', 'resize-image', 'crop-image', 'image-size-checker', 'image-dpi-checker'];
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const group = compressionGroupForSlug(slug);
const isTool = Boolean(group);
const isPngTool = slug === 'compress-png';
const isSignatureResizer = slug === 'signature-resizer';
const isSignatureCompressor = slug === 'signature-compressor';
const isBackgroundRemover = slug === 'signature-background-remover';
const isAspectRatioCalculator = slug === 'aspect-ratio-calculator';
const isPpiCalculator = slug === 'ppi-calculator';
const isPhotoResizer = slug === 'photo-resizer';
const isResizeTool = slug === 'resize-image';
const isCropTool = slug === 'crop-image';
const isSizeTool = slug === 'image-size-checker';
const isDpiTool = slug === 'image-dpi-checker';
const supportTool = isTool ? 'compress' : isResizeTool ? 'resize' : isCropTool ? 'crop' : isSizeTool ? 'size' : isDpiTool ? 'dpi' : null;
const toolTitle = group ? 'Compress an image to an exact KB target online' : 'Compress images to a target size';
const toolDescription = 'Set a byte-size target for a JPEG, PNG, or WebP image, then download a result checked against the exact KB limit. If a form asks you to resize an image to an exact KB limit, this controls file size; use the resize tool when you need exact pixel dimensions.';
const text: Record<string, { title: string; body: string }> = {
  tools: { title: 'Image tools', body: 'Use pixeltokb tools to reduce image bytes, resize pixels, crop, and inspect image metadata.' },
  blog: { title: 'pixeltokb blog', body: 'Practical guides about image bytes, pixels, DPI, and upload limits.' },
  about: { title: 'About PixelTokb', body: 'PixelTokb provides browser-based image compression, resizing, cropping, and inspection tools. Image processing stays on your device.' },
  contact: { title: 'Contact PixelTokb', body: 'Contact the PixelTokb team about corrections, privacy requests, or site feedback by email.' },
  privacy: { title: 'Privacy policy', body: 'This policy explains local image processing, browser preferences, hosting data, email, and advertising data if advertising is enabled later.' },
  terms: { title: 'Terms of use', body: 'These terms define permitted use of PixelTokb, user responsibilities, service limitations, and liability boundaries.' },
  cookies: { title: 'Cookies and consent', body: 'PixelTokb currently stores only theme and language preferences locally. Advertising and non-essential tracking remain disabled.' },
  'editorial-policy': { title: 'Editorial policy', body: 'PixelTokb publishes reviewed, reproducible image guidance with real examples, disclosed limitations, and a correction process.' },
  'how-it-works': { title: 'How it works', body: 'A browser Web Worker decodes the image, tries verified encodings, and checks the resulting Blob size. Processing is local.' },
  faq: { title: 'Frequently asked questions', body: 'KB means 1000 bytes and KiB means 1024 bytes. Targets are checked against exact output bytes, not rounded display values.' },
  changelog: { title: 'Changelog', body: 'Important changes to PixelTokb tools, content, languages, privacy information, and editorial practices are recorded here.' },
  'resize-image': { title: 'Resize image online by pixels', body: 'Use this private image resizer to set exact output dimensions, preserve the full image with Fit, crop to cover with Fill, or change the aspect ratio with Stretch.' },
  'signature-resizer': { title: 'Resize a signature image online', body: 'Crop a signature area, set exact output pixels, and download a white-background JPEG only after its actual byte size is checked locally.' },
  'signature-compressor': { title: 'Compress a signature image online', body: 'Prepare a signature image for a chosen file-size limit with local cropping, exact dimensions, and a white-background JPEG download.' },
  'signature-background-remover': { title: 'Remove a flat signature background online', body: 'Make a uniform paper or white signature background transparent with a local colour threshold. This is not AI subject segmentation.' },
  'photo-signature-merger': { title: 'Merge a photo and signature locally', body: 'Combine a photo and signature into one PNG with a vertical or horizontal layout, without uploading either file.' },
  'print-photo-sheet': { title: 'Create an A4 or Letter photo sheet PDF', body: 'Place repeated photos at a physical millimetre size on an A4 or Letter PDF with a 20 mm calibration line.' },
  'increase-image-size': { title: 'Increase a JPEG file size safely', body: 'Create a valid larger JPEG with an explicit standard comment-padding method, without adding pixels or claiming sharper detail.' },
  'crop-image': { title: 'Crop image online', body: 'Select a crop area visually or enter exact pixel coordinates. JPEG, PNG, and WebP images are processed on this device.' },
  'aspect-ratio-calculator': { title: 'Aspect ratio calculator', body: 'Reduce a pixel width and height to a simple aspect ratio, then calculate a matching side without uploading an image.' },
  'ppi-calculator': { title: 'PPI calculator for print size', body: 'Calculate horizontal, vertical, and diagonal pixels per inch from image pixels and a planned print size without uploading an image.' },
  'photo-resizer': { title: 'Resize a photo by mm, inches, and DPI', body: 'Set a physical print size and DPI, then download a locally resized JPEG or PNG with verified density metadata.' },
  'image-size-checker': { title: 'Image size and dimensions checker', body: 'Check exact bytes, KB and KiB, pixel dimensions, resolution, aspect ratio, file format, and transparency locally in your browser.' },
  'image-dpi-checker': { title: 'Image DPI checker', body: 'Check embedded DPI metadata when available and inspect the image pixel dimensions locally without uploading the file.' },
  'authors/editor': { title: 'Editor information', body: 'This page is reserved for the real editor information supplied during site setup.' }
};
const info = isPngTool ? { title: pngCopy.en.pageTitle, body: pngCopy.en.pageDescription } : text[slug] ?? { title: toolTitle, body: toolDescription };
---
<BaseLayout title={info.title} description={info.body} application={Boolean(supportTool) || isPngTool || isSignatureResizer || isSignatureCompressor || isBackgroundRemover || isAspectRatioCalculator || isPpiCalculator || isPhotoResizer}>
  <div class="detail-page">{isTool ? <><div class="hero"><p class="eyebrow">Image compression</p><h1>{info.title}</h1><p>{info.body}</p></div><CompressionTool client:load group={group} /><CompressionRangeNotes locale="en" /><section class="cards"><h2>Supported formats and limits</h2><p>Static JPEG, PNG, and WebP files up to 20 MB are accepted. Animated PNG and WebP files are rejected; export a still frame first. The decoded pixel limit is 40 megapixels. Confirm the exported format and exact byte count before using the result.</p></section></> : isPhotoResizer ? <><div class="hero"><p class="eyebrow">Print-size photo resize</p><h1>{info.title}</h1><p>{info.body}</p></div><PhotoResizer client:load /><section class="cards"><h2>Physical size is not approval</h2><p>Use the dimensions and DPI requested by the receiving service. This tool verifies the exported JPEG or PNG density tag, but it does not certify passport, visa, ID, or form eligibility.</p></section></> : isPngTool ? <PngOptimizationPage locale="en" /> : isBackgroundRemover ? <><div class="hero"><p class="eyebrow">Signature background cleanup</p><h1>{info.title}</h1><p>{info.body}</p></div><BackgroundRemover client:load /><section class="cards"><h2>When a threshold works</h2><p>A flat paper or white background can be removed by comparing each pixel with a sampled corner colour. Shadows, textured paper, hair, overlapping objects, and uneven lighting may require a different method; review the transparent PNG before use.</p></section></> : isSignatureResizer || isSignatureCompressor ? <><div class="hero"><p class="eyebrow">Signature image preparation</p><h1>{info.title}</h1><p>{info.body}</p></div><SignatureTool client:load variant={isSignatureResizer ? 'resize' : 'compress'} /><section class="cards"><h2>Use the receiving service’s current rules</h2><p>Choose the crop, dimensions, and file-size limit that your receiving service actually requests. This tool uses a white JPEG background and checks the final bytes, but it does not certify any government, exam, banking, or form requirement.</p></section></> : isAspectRatioCalculator ? <><div class="hero"><p class="eyebrow">Dimension planning</p><h1>{info.title}</h1><p>{info.body}</p></div><AspectRatioCalculator client:load /><section class="cards"><h2>Use a ratio before resizing</h2><p>A ratio describes the relationship between width and height. This calculator gives a rounded pixel result when a matching side does not land on a whole pixel; confirm the receiving service’s exact dimensions before exporting an image.</p></section></> : isPpiCalculator ? <><div class="hero"><p class="eyebrow">Print planning</p><h1>{info.title}</h1><p>{info.body}</p></div><PpiCalculator client:load /><section class="cards"><h2>PPI is not stored DPI</h2><p>This calculator estimates pixels per inch for a selected print size. It does not inspect a file’s metadata or write a DPI value; use the DPI checker to read metadata that a file actually contains.</p></section></> : isResizeTool ? <><div class="hero"><p class="eyebrow">Pixel resize</p><h1>{info.title}</h1><p>{info.body}</p></div><ResizeTool client:load /><section class="cards"><h2>How browser resizing works</h2><p>The original image is decoded and drawn to a new canvas inside a Web Worker. The result is encoded locally and offered as a download; transparent PNG and WebP images retain their alpha channel.</p></section></> : isCropTool ? <><div class="hero"><p class="eyebrow">Image crop</p><h1>{info.title}</h1><p>{info.body}</p></div><CropTool client:load /><section class="cards"><h2>How cropping works</h2><p>Drag across the preview to set a crop region, then refine its left edge, top edge, width, and height with keyboard-accessible fields. Transparent backgrounds are preserved in PNG and WebP exports.</p></section></> : isSizeTool || isDpiTool ? <><div class="hero"><p class="eyebrow">Image inspection</p><h1>{info.title}</h1><p>{info.body}</p></div><ImageInfoTool client:load mode={isSizeTool ? 'size' : 'dpi'} /><section class="cards"><h2>{isDpiTool ? 'Understanding DPI' : 'Supported image details'}</h2><p>{isDpiTool ? 'DPI is print metadata and does not change an image’s pixel dimensions. Some files do not include DPI metadata.' : 'JPEG, PNG, and WebP files up to 20 MB and 40 megapixels are supported.'}</p></section></> : <FoundationContent locale="en" slug={slug} title={info.title} intro={info.body} />}{supportTool && <ToolSupportingContent locale="en" tool={supportTool} />}</div>
</BaseLayout>
