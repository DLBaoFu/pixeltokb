  .ratio-calculator { display:grid; gap:1.25rem; margin-top:1.25rem; }.ratio-calculator h2 { margin:0 0 .7rem; font-size:1.08rem; }.ratio-input-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.85rem; }.ratio-input-grid label { display:grid; grid-template-columns:1fr auto; gap:.45rem .65rem; align-items:center; color:var(--muted); font-size:.86rem; font-weight:700; }.ratio-input-grid label input,.ratio-input-grid label select { grid-column:1; width:100%; min-height:44px; padding:.65rem .75rem; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); font:inherit; }.ratio-input-grid label span { grid-column:2; grid-row:2; color:var(--muted); font-weight:600; }.ratio-result { padding:1.1rem; border:1px solid color-mix(in srgb,var(--cyan) 35%,var(--line)); border-radius:10px; background:color-mix(in srgb,var(--cyan) 6%,var(--surface)); }.ratio-hero-value { margin:.1rem 0 1rem; color:var(--cyan-deep); font-size:clamp(2rem,4vw,3rem); font-weight:850; letter-spacing:-.06em; }.ratio-result dl { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin:0; }.ratio-result dl div { padding:.7rem; border-radius:8px; background:var(--surface); }.ratio-result dt { color:var(--muted); font-size:.75rem; }.ratio-result dd { margin:.24rem 0 0; font-weight:800; }.ratio-companion { padding-top:.15rem; border-top:1px solid var(--line); }.ratio-companion-grid { grid-template-columns:repeat(3,minmax(0,1fr)); align-items:end; }.ratio-output { display:grid; min-height:44px; padding:.58rem .75rem; border:1px solid var(--line); border-radius:8px; background:var(--surface); }.ratio-output strong { color:var(--muted); font-size:.75rem; }.ratio-output span { margin-top:.15rem; color:var(--ink); font-size:1rem; font-weight:800; }.ratio-note { margin:.65rem 0 0; color:var(--muted); font-size:.82rem; line-height:1.55; }.ratio-calculator .secondary-action { justify-self:start; min-height:42px; padding:.55rem .9rem; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); font:inherit; font-weight:750; cursor:pointer; }
  .ppi-calculator { display:grid; gap:1.25rem; margin-top:1.25rem; }.ppi-calculator h2 { margin:0 0 .7rem; font-size:1.08rem; }.ppi-input-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.85rem; }.ppi-print-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }.ppi-input-grid label { display:grid; grid-template-columns:1fr auto; gap:.45rem .65rem; align-items:center; color:var(--muted); font-size:.86rem; font-weight:700; }.ppi-input-grid label input,.ppi-input-grid label select { grid-column:1; width:100%; min-height:44px; padding:.65rem .75rem; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); font:inherit; }.ppi-input-grid label span { grid-column:2; grid-row:2; color:var(--muted); font-weight:600; }.ppi-note { margin:.65rem 0 0; color:var(--muted); font-size:.82rem; line-height:1.55; }.ppi-result { padding:1.1rem; border:1px solid color-mix(in srgb,var(--cyan) 35%,var(--line)); border-radius:10px; background:color-mix(in srgb,var(--cyan) 6%,var(--surface)); }.ppi-result dl { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin:0; }.ppi-result dl div { padding:.8rem; border-radius:8px; background:var(--surface); }.ppi-result dt { color:var(--muted); font-size:.75rem; }.ppi-result dd { margin:.24rem 0 0; font-size:1.25rem; font-weight:850; }.ppi-result dd span { font-size:.78rem; }.ppi-result .status { margin:.9rem 0 0; }.ppi-explanation { padding:.8rem .9rem; border-left:3px solid var(--cyan); border-radius:0 8px 8px 0; background:color-mix(in srgb,var(--cyan) 6%,var(--surface)); }.ppi-calculator .secondary-action { justify-self:start; min-height:42px; padding:.55rem .9rem; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); font:inherit; font-weight:750; cursor:pointer; }
  .physical-resizer { display:grid; gap:1rem; margin-top:1.25rem; }.physical-presets { display:flex; flex-wrap:wrap; gap:.55rem; }.physical-presets button,.physical-actions .secondary-action { min-height:42px; padding:.5rem .75rem; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); font:inherit; font-weight:750; }.physical-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem .8rem; }.physical-grid label { display:grid; gap:.35rem; align-content:start; color:var(--muted); font-size:.86rem; font-weight:700; }.physical-grid input,.physical-grid select { width:100%; min-width:0; min-height:46px; padding:.6rem .7rem; border:1px solid var(--line); border-radius:9px; background:var(--surface); color:var(--ink); font:inherit; }.physical-select-wrap { position:relative; display:block; }.physical-select-wrap::after { content:'⌄'; position:absolute; top:50%; right:.8rem; color:var(--muted); font-size:1rem; line-height:1; pointer-events:none; transform:translateY(-55%); }.physical-grid select { appearance:none; padding-right:2.4rem; cursor:pointer; }.physical-grid output { display:grid; align-content:center; align-self:end; min-height:72px; padding:.65rem .8rem; border:1px solid color-mix(in srgb,var(--cyan) 32%,var(--line)); border-radius:9px; background:color-mix(in srgb,var(--cyan) 6%,var(--surface)); }.physical-grid output strong { color:var(--muted); font-size:.75rem; }.physical-grid output span { margin-top:.15rem; color:var(--ink); font-size:1.03rem; font-weight:850; font-variant-numeric:tabular-nums; }.physical-note,.physical-warning { margin:0; color:var(--muted); font-size:.84rem; line-height:1.55; }.physical-warning { padding:.8rem .9rem; border-left:3px solid var(--cyan); background:color-mix(in srgb,var(--cyan) 6%,var(--surface)); }.physical-actions { display:flex; flex-wrap:wrap; gap:.7rem; }.physical-actions .primary-action { width:auto; min-width:180px; padding-inline:1rem; }.physical-result { display:grid; gap:.4rem; padding:1rem; border:1px solid #a6e8cf; border-radius:9px; background:#f2fff9; color:#075e38; }.physical-result span { font-size:.86rem; }.physical-result a { width:max-content; min-height:42px; display:inline-flex; align-items:center; padding:.5rem .8rem; border:1px solid currentColor; border-radius:8px; color:inherit; font-weight:800; } :root[data-theme="dark"] .physical-result { border-color:#21795c; background:#0a3026; color:#aff5d7; }
  :root[data-theme="dark"] .status.error { color:#ff9aab; }
  :root[data-theme="dark"] .status.success { color:#7ee2b8; }
