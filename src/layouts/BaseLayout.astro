  @media (max-width:620px) { .ratio-input-grid,.ratio-companion-grid,.ratio-result dl,.ppi-input-grid,.ppi-print-grid,.ppi-result dl,.physical-grid { grid-template-columns:1fr; }.ratio-input-grid label { max-width:none; }.ratio-output { min-height:62px; } }
  @media (forced-colors:active) { .brand-mark,.upload-zone-inner,.dropzone,.crop-selection { forced-color-adjust:auto; } .preset.active,.primary-action,.tool-shell>button,.info-upload,.crop-controls .primary-action { border:2px solid ButtonText; } }
  @media (max-width:900px) {
    .tool-card-grid .tool-card:nth-child(-n+2) { grid-column:span 3; }
