  }
  .guide-sources>div { padding:1.05rem 0; border-top:1px solid var(--line); }
  .guide-sources h3 { margin:0 0 .25rem; font-size:1rem; }
  .guide-sources p { margin:0; }
  /* Blog system: a readable editorial shell with real article metadata, navigation, and related reading. */
  .blog-directory { max-width:1120px; margin:0 auto; padding:2.8rem 0 4rem; }
  .blog-directory-header { max-width:820px; padding-bottom:2rem; }
  .article-breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:.55rem; margin-bottom:1.2rem; color:var(--muted); font-size:.8rem; }
  .article-breadcrumb a { color:var(--cyan-deep); font-weight:750; text-decoration:underline; text-underline-offset:.18em; }
  .blog-directory-header h1 { max-width:780px; margin:.2rem 0 .75rem; font-size:clamp(2.65rem,5vw,4.35rem); letter-spacing:-.065em; }
  .blog-directory-dek { max-width:700px; margin:0; color:var(--muted); font-size:1.12rem; line-height:1.75; }
  .blog-topic-nav { display:flex; flex-wrap:wrap; gap:.6rem; margin-top:1.6rem; }
  .blog-topic-nav a { min-height:40px; display:inline-flex; align-items:center; padding:.52rem .85rem; border:1px solid var(--line); border-radius:999px; background:var(--surface); color:var(--ink) !important; font-size:.86rem; font-weight:750; transition:none; }
  .blog-topic-nav a:hover,.blog-topic-nav a.is-current { border-color:var(--cyan); color:var(--cyan-deep) !important; background:color-mix(in srgb,var(--cyan) 7%,var(--surface)); }
  .blog-featured { display:grid; grid-template-columns:minmax(0,1.18fr) minmax(280px,.78fr); gap:2rem; align-items:center; margin:1.2rem 0 3.7rem; padding:1.2rem; border:1px solid var(--line); border-radius:18px; background:color-mix(in srgb,var(--cyan) 4%,var(--surface)); box-shadow:var(--shadow); }
  .blog-featured-copy { display:flex; flex-direction:column; justify-content:center; padding:1.1rem 1.2rem 1.1rem 1.3rem; }
  .article-kicker { margin:0 0 .65rem; color:var(--cyan-deep); font-size:.74rem; font-weight:850; letter-spacing:.11em; text-transform:uppercase; }
  .blog-featured h2 { max-width:650px; margin:0 0 .7rem; font-size:clamp(1.85rem,3vw,2.7rem); letter-spacing:-.05em; line-height:1.08; }
  .blog-featured h2 a,.blog-card h3 a { color:var(--ink); text-decoration:none; }
  .blog-featured h2 a:hover,.blog-card h3 a:hover { color:var(--cyan-deep); }
  .blog-featured-copy>p:not(.article-kicker) { max-width:610px; margin:0; color:var(--muted); line-height:1.75; }
  .blog-featured-image { display:block; width:100%; height:230px; overflow:hidden; aspect-ratio:4 / 3; border-radius:12px; background:var(--hero); }
  .blog-featured-image img,.blog-card-image img { display:block; width:100%; height:100%; object-fit:cover; object-position:center; }
  .article-card-meta { display:flex; flex-wrap:wrap; gap:.7rem; margin:1rem 0; color:var(--muted); font-size:.78rem; }
  .article-card-meta span+span::before { content:'·'; margin-right:.7rem; color:var(--line-strong); }
  .text-link { display:inline-flex; align-items:center; gap:.42rem; width:max-content; margin-top:1rem; color:var(--cyan-deep); font-size:.86rem; font-weight:800; text-decoration:underline; text-underline-offset:.18em; }
  .blog-list-section { margin-top:2rem; }
  .blog-section-heading { display:flex; align-items:end; justify-content:space-between; gap:1rem; margin-bottom:1.1rem; }
  .blog-section-heading h2 { margin:.15rem 0 0; font-size:1.8rem; letter-spacing:-.045em; }
  .blog-section-heading .text-link { margin:0; }
  .blog-card-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .blog-card { display:grid; grid-template-columns:minmax(150px,.72fr) minmax(0,1.28fr); min-height:185px; overflow:hidden; border:1px solid var(--line); border-radius:14px; background:var(--surface); box-shadow:var(--shadow); }
  .blog-card-image { display:block; align-self:center; width:auto; height:calc(185px - 1.3rem); margin:.65rem; min-height:0; max-height:none; overflow:hidden; border-radius:10px; background:var(--hero); }
  .blog-card-body { display:flex; flex-direction:column; padding:1.1rem 1.15rem 1rem; }
  .blog-card h3 { margin:0; font-size:1.18rem; letter-spacing:-.03em; line-height:1.2; }
  .blog-card-body>p:not(.article-kicker) { margin:.55rem 0 0; color:var(--muted); font-size:.87rem; line-height:1.65; }
  .blog-card-body .article-card-meta { margin-top:auto; margin-bottom:0; }
  .blog-tools-cta { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:1.4rem; align-items:center; margin-top:3.8rem; padding:1.35rem 1.45rem; border:1px solid color-mix(in srgb,var(--cyan) 35%,var(--line)); border-radius:14px; background:color-mix(in srgb,var(--cyan) 6%,var(--surface)); }
  .blog-tools-cta h2 { margin:.15rem 0 .35rem; font-size:1.5rem; letter-spacing:-.04em; }
  .blog-tools-cta p:last-child { max-width:620px; margin:0; color:var(--muted); line-height:1.65; }
  .blog-tool-links { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:.55rem; }
  .blog-tool-links a,.article-sidebar-link,.article-tool-cta>a { display:inline-flex; align-items:center; gap:.45rem; min-height:44px; padding:.63rem .82rem; border:1px solid var(--line); border-radius:9px; background:var(--surface); color:var(--cyan-deep); font-size:.84rem; font-weight:800; }
  .blog-category-page .blog-directory-header { padding-bottom:1.2rem; }
  .article-page { max-width:1120px; margin:0 auto; padding:2.7rem 0 4rem; }
  .article-header { max-width:860px; padding-bottom:2rem; }
  .article-header h1 { max-width:850px; margin:.25rem 0 .85rem; font-size:clamp(2.55rem,5vw,4.45rem); letter-spacing:-.07em; line-height:1.04; }
  .article-dek { max-width:760px; margin:0; color:var(--muted); font-size:1.15rem; line-height:1.75; }
  .article-byline { display:flex; align-items:center; gap:.75rem; margin-top:1.45rem; color:var(--muted); font-size:.8rem; }
  .article-avatar { display:grid; width:38px; height:38px; place-items:center; border-radius:50%; background:linear-gradient(135deg,var(--cyan),var(--violet)); color:#fff; font-size:.7rem; font-weight:850; letter-spacing:.06em; }
  .article-byline div { display:grid; gap:.12rem; }
  .article-byline strong { color:var(--ink); font-size:.86rem; }
  .article-reading-time { margin-left:.25rem; padding-left:.8rem; border-left:1px solid var(--line); }
  .article-layout { display:grid; grid-template-columns:220px minmax(0,760px); gap:3.1rem; align-items:start; }
  .article-sidebar { position:sticky; top:1.2rem; }
  .article-toc { padding:1rem 1rem 1.1rem; border:1px solid var(--line); border-radius:12px; background:var(--surface); box-shadow:var(--shadow); }
  .article-toc>p { margin:0 0 .55rem; color:var(--ink); font-size:.78rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
  .article-toc ol { display:grid; gap:.45rem; margin:0; padding-left:1.1rem; }
  .article-toc li { color:var(--muted); font-size:.8rem; line-height:1.4; }
  .article-toc a { color:var(--muted); }
  .article-toc a:hover { color:var(--cyan-deep); }
  .article-sidebar-link { margin-top:.75rem; width:100%; justify-content:space-between; }
  .article-content { min-width:0; }
  .article-lead-note { margin-bottom:2.25rem; padding:1.15rem 1.3rem; border-left:4px solid var(--cyan); border-radius:0 12px 12px 0; background:color-mix(in srgb,var(--cyan) 7%,var(--surface)); }
  .article-note-label { margin:0 0 .38rem; color:var(--cyan-deep); font-size:.72rem; font-weight:850; letter-spacing:.1em; text-transform:uppercase; }
  .article-lead-note>p:last-child { margin:0; color:var(--ink); font-size:1rem; line-height:1.75; }
  .article-section { scroll-margin-top:1.2rem; margin:2.4rem 0; }
  .article-section h2,.article-result h2,.article-check h2,.article-tool-cta h2,.article-related h2 { margin:0 0 .65rem; font-size:1.55rem; letter-spacing:-.045em; line-height:1.18; }
  .article-section>p { max-width:720px; margin:0; color:var(--muted); font-size:1rem; line-height:1.9; }
  .article-steps-section { margin-top:0; }
  .article-steps { display:grid; gap:.75rem; margin:0; padding:0; list-style:none; counter-reset:none; }
  .article-steps li { display:grid; grid-template-columns:34px minmax(0,1fr); gap:.8rem; padding:1rem; border:1px solid var(--line); border-radius:11px; background:var(--surface); }
  .article-step-number { display:grid; width:30px; height:30px; place-items:center; border-radius:50%; background:color-mix(in srgb,var(--cyan) 15%,var(--surface)); color:var(--cyan-deep); font-weight:850; }
  .article-steps h3 { margin:.1rem 0 .2rem; font-size:1rem; }
  .article-steps p { margin:0; color:var(--muted); font-size:.92rem; line-height:1.7; }
  .article-figure { margin:2.3rem 0; overflow:hidden; border:1px solid var(--line); border-radius:14px; background:var(--surface); box-shadow:var(--shadow); }
  .article-figure img { display:block; width:100%; height:auto; }
  .article-figure figcaption { padding:.85rem 1rem; color:var(--muted); font-size:.82rem; line-height:1.65; }
  .article-result { scroll-margin-top:1.2rem; margin:2.5rem 0; padding:1.3rem; border:1px solid color-mix(in srgb,var(--cyan) 32%,var(--line)); border-radius:13px; background:color-mix(in srgb,var(--cyan) 5%,var(--surface)); }
  .article-result-heading h2 { margin-bottom:1rem; }
  .article-result dl { margin:0; border-top:1px solid var(--line); }
  .article-result dl div { display:grid; grid-template-columns:minmax(9rem,.65fr) minmax(0,1.35fr); gap:1rem; padding:.7rem 0; border-bottom:1px solid var(--line); }
  .article-result dt { font-weight:800; }
  .article-result dd { margin:0; color:var(--muted); }
  .article-result-note { margin:.95rem 0 0; color:var(--muted); font-size:.9rem; line-height:1.7; }
  .article-check { scroll-margin-top:1.2rem; margin-top:2.8rem; padding-top:1rem; border-top:1px solid var(--line); }
  .article-check>div { padding:1rem 0; border-bottom:1px solid var(--line); }
  .article-check h3 { margin:0 0 .25rem; font-size:1rem; }
  .article-check p { margin:0; color:var(--muted); line-height:1.75; }
  .article-tool-cta { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-top:2.7rem; padding:1.15rem 1.25rem; border:1px solid var(--line); border-radius:12px; background:var(--surface); box-shadow:var(--shadow); }
  .article-tool-cta h2 { margin-bottom:0; }
  .article-related { margin-top:3.3rem; }
  .article-related-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.8rem; }
  .article-related-grid>a { display:flex; flex-direction:column; min-height:175px; padding:1rem; border:1px solid var(--line); border-radius:11px; background:var(--surface); }
  .article-related-grid h3 { margin:0; font-size:1rem; line-height:1.3; }
  .article-related-grid p { margin:.5rem 0 0; color:var(--muted); font-size:.86rem; line-height:1.6; }
  .article-related-grid .text-link { margin-top:auto; }
  .article-pagination { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-top:2.7rem; padding-top:1.1rem; border-top:1px solid var(--line); }
  .article-pagination a { display:flex; flex-direction:column; gap:.28rem; min-height:66px; color:var(--ink); }
  .article-pagination a:last-child { text-align:right; align-items:flex-end; }
  .article-pagination span { color:var(--muted); font-size:.76rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; }
  .article-pagination strong { color:var(--cyan-deep); font-size:.9rem; line-height:1.45; }
  .range-context { margin-top:2.2rem; padding:1.35rem; border:1px solid color-mix(in srgb,var(--cyan) 32%,var(--line)); border-radius:14px; background:color-mix(in srgb,var(--cyan) 5%,var(--surface)); }
  .range-context-item + .range-context-item { margin-top:1.35rem; padding-top:1.35rem; border-top:1px solid var(--line); }
  .range-context h2 { margin:0 0 .45rem; font-size:1.65rem; letter-spacing:-.045em; }
  .range-context-intro { max-width:760px; margin:0; color:var(--muted); line-height:1.75; }
  .range-context-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.8rem; margin-top:1rem; }
  .range-context-grid article { padding:1rem; border:1px solid var(--line); border-radius:10px; background:var(--surface); }
  .range-context-grid h3,.range-context-check h3 { margin:0 0 .35rem; font-size:.98rem; }
  .range-context-grid p,.range-context-check p { margin:0; color:var(--muted); font-size:.88rem; line-height:1.7; }
  .range-context-check { margin-top:.8rem; padding:1rem; border-left:3px solid var(--cyan); border-radius:0 10px 10px 0; background:color-mix(in srgb,var(--cyan) 8%,var(--surface)); }
  :root[data-theme="dark"] .blog-topic-nav a { color:#a7b6cf; }
  :root[data-theme="dark"] .blog-topic-nav a.is-current { color:#62d7f2; border-color:#20bde2; }
