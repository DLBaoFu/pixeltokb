---
import { htmlLang, layoutCopy, publishedLocales, type Locale } from '../lib/locales';
import { compressionGroupOrder, compressionGroups } from '../lib/compression-groups';
import { isPendingReview } from '../lib/publication.mjs';
import { seoKeywords } from '../lib/seo';
interface Props { title: string; description?: string; locale?: Locale; noindex?: boolean; application?: boolean; }
const { title, description, locale = 'en', noindex: requestedNoindex = false, application = false } = Astro.props;
const noindex = requestedNoindex || isPendingReview(Astro.url.pathname);
const copy = layoutCopy[locale];
const pageDescription = description ?? copy.footerTagline;
const origin = import.meta.env.SITE_ORIGIN || 'https://www.pixeltokb.com';
const unprefixedPath = Astro.url.pathname.replace(/^\/(en|zh-cn|zh-tw)(?=\/|$)/, '') || '/';
const pathFor = (path: string) => locale === 'en' ? path : `/${locale}${path}`;
const localizedPath = (targetLocale: Locale) => {
  if (unprefixedPath === '/') return targetLocale === 'en' ? '/' : `/${targetLocale}/`;
  return targetLocale === 'en' ? unprefixedPath : `/${targetLocale}${unprefixedPath}`;
};
const primarySection = unprefixedPath.startsWith('/tools') || ['/compress-image/', '/compress-image-200kb-to-500kb/', '/compress-image-500kb-to-1mb/', '/compress-image-2mb-to-5mb/', '/resize-image/', '/crop-image/', '/image-size-checker/', '/image-dpi-checker/'].includes(unprefixedPath)
  ? 'tools'
  : unprefixedPath.startsWith('/blog') ? 'blog' : unprefixedPath === '/privacy/' ? 'privacy' : null;
const skipLabel = locale === 'en' ? 'Skip to main content' : locale === 'zh-cn' ? '跳到主要内容' : '跳到主要內容';
const canonical = new URL(localizedPath(locale), origin);
const alternates = publishedLocales.map((targetLocale) => ({ locale: htmlLang[targetLocale], href: new URL(localizedPath(targetLocale), origin) }));
const englishAlternate = alternates.find((item) => item.locale === 'en')!.href;
const keywords = seoKeywords(Astro.url.pathname, locale, title);
const socialLocale = locale === 'zh-cn' ? 'zh_CN' : locale === 'zh-tw' ? 'zh_TW' : 'en_US';
const alternateSocialLocales = publishedLocales.filter((item) => item !== locale).map((item) => item === 'zh-cn' ? 'zh_CN' : item === 'zh-tw' ? 'zh_TW' : 'en_US');
const socialImage = new URL('/og-image.png', origin).href;
const socialImageAlt = locale === 'en' ? 'PixelToKB browser image tools' : locale === 'zh-cn' ? 'PixelToKB 浏览器图片工具' : 'PixelToKB 瀏覽器圖片工具';
const organizationId = `${origin}/#organization`;
const websiteId = `${origin}/#website`;
const imageId = `${origin}/#primaryimage`;
const graphSchema = !noindex ? JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': organizationId, name: 'PixelTokb', url: `${origin}/`, email: 'Support@piexltokb.com', logo: new URL('/favicon.svg', origin).href, sameAs: ['https://github.com/DLBaoFu/pixeltokb'] },
    { '@type': 'WebSite', '@id': websiteId, name: 'PixelToKB', description: 'Privacy-first browser image compression, resizing, cropping, and inspection tools.', url: `${origin}/`, inLanguage: ['en', 'zh-CN', 'zh-TW'], publisher: { '@id': organizationId } },
    { '@type': 'ImageObject', '@id': imageId, url: socialImage, contentUrl: socialImage, width: 1200, height: 630, caption: socialImageAlt },
    { '@type': 'WebPage', '@id': `${canonical.href}#webpage`, name: title, description: pageDescription, url: canonical.href, inLanguage: htmlLang[locale], dateModified: '2026-10-13', isPartOf: { '@id': websiteId }, about: { '@id': organizationId }, author: { '@id': organizationId }, publisher: { '@id': organizationId }, primaryImageOfPage: { '@id': imageId } }
  ]
}).replace(/</g, '\\u003c') : null;
// Tool schema is emitted only for canonical, indexable routes. It deliberately omits
// unsupported claims such as ratings, reviews, operating company, or feature lists.
const applicationSchema = application && !noindex ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description: pageDescription,
  url: canonical.href,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  codeRepository: 'https://github.com/DLBaoFu/pixeltokb'
}).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang={htmlLang[locale]} data-locale={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="application-name" content="PixelToKB" />
    <title>{title} | pixeltokb</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="PixelTokb" />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
    {!noindex && <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
    {!noindex && <meta name="bingbot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={englishAlternate} />}
    {!noindex && <meta property="og:type" content="website" />}
    {!noindex && <meta property="og:site_name" content="PixelTokb" />}
    {!noindex && <meta property="og:title" content={`${title} | pixeltokb`} />}
    {!noindex && <meta property="og:description" content={pageDescription} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    {!noindex && <meta property="og:locale" content={socialLocale} />}
    {!noindex && alternateSocialLocales.map((item) => <meta property="og:locale:alternate" content={item} />)}
    {!noindex && <meta property="og:image" content={socialImage} />}
    {!noindex && <meta property="og:image:secure_url" content={socialImage} />}
    {!noindex && <meta property="og:image:type" content="image/png" />}
    {!noindex && <meta property="og:image:width" content="1200" />}
    {!noindex && <meta property="og:image:height" content="630" />}
    {!noindex && <meta property="og:image:alt" content={socialImageAlt} />}
    {!noindex && <meta name="twitter:card" content="summary_large_image" />}
    {!noindex && <meta name="twitter:title" content={`${title} | pixeltokb`} />}
    {!noindex && <meta name="twitter:description" content={pageDescription} />}
    {!noindex && <meta name="twitter:image" content={socialImage} />}
    {!noindex && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {graphSchema && <script type="application/ld+json" set:html={graphSchema} />}
    {applicationSchema && <script type="application/ld+json" set:html={applicationSchema} />}
    <script is:inline>
      (() => { try { const saved = localStorage.getItem('pixeltokb-theme') || 'light'; const dark = saved === 'dark' || (saved === 'system' && matchMedia('(prefers-color-scheme: dark)').matches); document.documentElement.dataset.theme = dark ? 'dark' : 'light'; document.documentElement.dataset.themePreference = saved; } catch {} })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <header class="site-header">
      <a class="brand" href={locale === 'en' ? '/' : `/${locale}/`} aria-label={copy.home}><span class="brand-mark" aria-hidden="true"><i></i></span><span>pixel<span>to</span>kb</span></a>
      <nav aria-label={locale === 'en' ? 'Primary' : locale === 'zh-cn' ? '主导航' : '主導覽'}><a href={pathFor('/tools/')} aria-current={primarySection === 'tools' ? 'page' : undefined}>{copy.navTools}</a><a href={pathFor('/blog/')} aria-current={primarySection === 'blog' ? 'page' : undefined}>{copy.navBlog}</a><a href={pathFor('/privacy/')} aria-current={primarySection === 'privacy' ? 'page' : undefined}>{copy.navPrivacy}</a></nav>
      <div class="header-actions">
        <details class="language-menu"><summary aria-label={copy.language}><span aria-hidden="true">◎</span> <span>{copy.localeNames[locale]}</span> <span aria-hidden="true">⌄</span></summary><div>{publishedLocales.map((targetLocale) => <a href={localizedPath(targetLocale)} lang={htmlLang[targetLocale]} aria-current={targetLocale === locale ? 'page' : undefined}>{copy.localeNames[targetLocale]}</a>)}</div></details>
        <div class="theme-picker" role="group" aria-label={copy.theme}><button type="button" data-theme-choice="light" aria-label={copy.light} aria-pressed="false">☀ <span>{copy.light}</span></button><button type="button" data-theme-choice="system" aria-label={copy.system} aria-pressed="false">▣ <span>{copy.system}</span></button><button type="button" data-theme-choice="dark" aria-label={copy.dark} aria-pressed="false">☾ <span>{copy.dark}</span></button></div>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-grid">
        <section><a class="brand footer-brand" href={locale === 'en' ? '/' : `/${locale}/`}><span class="brand-mark" aria-hidden="true"><i></i></span><span>pixel<span>to</span>kb</span></a><p>{copy.footerTagline}</p></section>
        <section><h2>{copy.footerTools}</h2><a href={pathFor('/compress-image/')}>{copy.compress}</a><a href={pathFor('/resize-image/')}>{copy.resize}</a><a href={pathFor('/crop-image/')}>{copy.crop}</a><a href={pathFor('/image-size-checker/')}>{copy.sizeCheck}</a><a href={pathFor('/image-dpi-checker/')}>{copy.dpiCheck}</a></section>
        <section><h2>{copy.footerSizes}</h2>{compressionGroupOrder.map((group) => <a href={pathFor(`/${compressionGroups[group].slug}/`)}>{copy.compressTo(compressionGroups[group].label)}</a>)}</section>
        <section><h2>{copy.footerResources}</h2><a href={pathFor('/blog/')}>{copy.blog}</a><a href={pathFor('/privacy/')}>{copy.privacy}</a><a href={pathFor('/how-it-works/')}>{copy.how}</a></section>
        <section><h2>{copy.footerCompany}</h2><a href={pathFor('/about/')}>{copy.about}</a><a href={pathFor('/contact/')}>{copy.contact}</a><a href={pathFor('/terms/')}>{copy.terms}</a></section>
      </div>
      <div class="footer-bottom"><span>© 2026 pixeltokb. {copy.allRights}</span><span><a href={pathFor('/privacy/')}>{copy.privacy}</a><a href={pathFor('/contact/')}>{copy.contact}</a></span></div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const locale = root.dataset.locale || 'en';
        try { localStorage.setItem('pixeltokb-locale', locale); } catch {}
        const leaveWarning = {
          en: 'Switching language will clear the selected image and any result. Continue?',
          'zh-cn': '切换语言会清除已选择的图片和处理结果。是否继续？',
          'zh-tw': '切換語言會清除已選取的圖片與處理結果。是否繼續？'
        };
        document.querySelectorAll('.language-menu a').forEach((link) => link.addEventListener('click', (event) => {
          if (link.getAttribute('aria-current') === 'page') return;
          const selectedFile = Boolean(document.querySelector('[data-image-selected="true"]')) || [...document.querySelectorAll('input[type="file"]')].some((input) => input instanceof HTMLInputElement && input.files?.length);
          const warning = locale === 'zh-cn' ? leaveWarning['zh-cn'] : locale === 'zh-tw' ? leaveWarning['zh-tw'] : leaveWarning.en;
          if (selectedFile && !confirm(warning)) event.preventDefault();
        }));
        const buttons = document.querySelectorAll('[data-theme-choice]');
        // @ts-ignore Browser runtime script; Astro emits this verbatim.
        const apply = (choice) => {
          const dark = choice === 'dark' || (choice === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          root.dataset.theme = dark ? 'dark' : 'light'; root.dataset.themePreference = choice;
          buttons.forEach((button) => { const active = button.getAttribute('data-theme-choice') === choice; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); });
        };
        apply(root.dataset.themePreference || 'light');
        buttons.forEach((button) => button.addEventListener('click', () => { const choice = button.getAttribute('data-theme-choice') || 'light'; try { localStorage.setItem('pixeltokb-theme', choice); } catch {} apply(choice); }));
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { if ((root.dataset.themePreference || 'light') === 'system') apply('system'); });
      })();
    </script>
  </body>
</html>
<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #111a44; background: #fff; }
  :root[data-theme="light"] { --page:#fff; --surface:#fff; --ink:#111a44; --muted:#566787; --line:#cbdbe8; --cyan:#0789b8; --cyan-deep:#056b98; --action:#0576a4; --action-end:#006b98; --focus:#6936d1; --violet:#7442d1; --shadow:0 12px 34px rgba(67,97,151,.08); --hero:radial-gradient(circle at 88% 1%,rgba(135,96,255,.18),transparent 24rem),radial-gradient(circle at 72% 8%,rgba(22,202,242,.16),transparent 25rem),linear-gradient(#fafdff,#fff); }
  :root[data-theme="dark"] { color-scheme:dark; --page:#071322; --surface:#0d2035; --ink:#f4f8ff; --muted:#b8c8e1; --line:#365b77; --cyan:#22d3ee; --cyan-deep:#67e8f9; --action:#087fa8; --action-end:#066b94; --focus:#f0c85a; --violet:#b69afa; --shadow:0 14px 40px rgba(0,0,0,.25); --hero:radial-gradient(circle at 88% 1%,rgba(135,96,255,.2),transparent 24rem),radial-gradient(circle at 72% 8%,rgba(22,202,242,.16),transparent 25rem),linear-gradient(#091829,#071322); }
  * { box-sizing:border-box; } html { background:var(--page); } body { margin:0; min-width:320px; color:var(--ink); background:var(--page); line-height:1.5; } a { color:inherit; text-decoration:none; } a:hover { color:var(--cyan-deep); } button,input,select { font:inherit; } button { cursor:pointer; } button:disabled { cursor:not-allowed; opacity:.65; } :focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
  .skip-link { position:fixed; top:.5rem; left:.5rem; z-index:100; padding:.7rem 1rem; border-radius:8px; color:white; background:#111a44; transform:translateY(-160%); box-shadow:var(--shadow); font-weight:800; }.skip-link:focus { transform:translateY(0); color:white; }
  .sr-only { position:absolute !important; width:1px !important; height:1px !important; padding:0 !important; margin:-1px !important; overflow:hidden !important; clip:rect(0,0,0,0) !important; white-space:nowrap !important; border:0 !important; }
  .content-prose a,.guide-article p a,.foundation-card a { color:var(--cyan-deep); text-decoration:underline; text-decoration-thickness:.08em; text-underline-offset:.16em; }
  .site-header { height:65px; padding:0 max(2rem,calc((100vw - 1120px)/2)); display:flex; align-items:center; gap:2rem; border-bottom:1px solid var(--line); background:color-mix(in srgb,var(--page) 94%,transparent); position:relative; z-index:2; }.brand { display:inline-flex; align-items:center; gap:.65rem; color:var(--ink); font-size:1.55rem; font-weight:800; letter-spacing:-.07em; white-space:nowrap; }.brand>span:last-child span { color:var(--cyan); }.brand-mark { width:28px; height:28px; border:2px dashed var(--cyan); border-radius:6px; padding:5px; display:grid; place-items:center; }.brand-mark i { width:10px; height:10px; display:block; background:var(--cyan); border-radius:2px; }nav { display:flex; gap:2.25rem; margin-left:auto; font-size:.89rem; font-weight:650; }.header-actions { display:flex; align-items:center; gap:.75rem; }.language-menu { position:relative; }.language-menu summary { list-style:none; min-height:39px; display:flex; align-items:center; gap:.45rem; padding:0 .75rem; border:1px solid var(--line); border-radius:8px; color:var(--ink); font-size:.85rem; font-weight:650; cursor:pointer; white-space:nowrap; }.language-menu summary::-webkit-details-marker { display:none; }.language-menu div { position:absolute; right:0; top:calc(100% + .5rem); width:max-content; min-width:100%; max-width:min(19rem,calc(100vw - 2rem)); padding:.45rem; border:1px solid var(--line); border-radius:9px; background:var(--surface); box-shadow:var(--shadow); }.language-menu:not([open]) div { display:none; }.language-menu div a { display:block; width:100%; padding:.55rem .7rem; border-radius:6px; font-size:.84rem; font-weight:650; white-space:nowrap; }.language-menu div a[aria-current="page"] { color:var(--cyan-deep); background:color-mix(in srgb,var(--cyan) 14%,var(--surface)); }.language-menu div a:hover { background:color-mix(in srgb,var(--cyan) 12%,var(--surface)); }.theme-picker { display:flex; min-height:39px; border:1px solid var(--line); border-radius:8px; overflow:hidden; background:var(--surface); }.theme-picker button { display:flex; align-items:center; gap:.35rem; padding:0 .62rem; border:0; border-left:1px solid var(--line); background:transparent; color:var(--ink); font-size:.79rem; }.theme-picker button:first-child { border-left:0; }.theme-picker button.is-active { color:#07658e; background:#dff7ff; }:root[data-theme="dark"] .theme-picker button.is-active { color:#062331; background:var(--cyan); }
  main { min-height:calc(100vh - 65px); padding-bottom:0; }main > :not(.home-shell) { width:min(calc(100% - 4rem),1120px); margin-inline:auto; }.home-shell { background-image:linear-gradient(rgba(15,153,205,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(15,153,205,.055) 1px,transparent 1px),var(--hero); background-size:32px 32px,32px 32px,auto; padding:2.2rem max(2rem,calc((100vw - 1120px)/2)) 4rem; }.home-shell>* { max-width:1120px; margin-inline:auto; }.hero { padding:.5rem 0 1rem; }h1,h2,h3,p { margin-top:0; }h1 { max-width:720px; margin-bottom:.15rem; font-size:clamp(2.5rem,5vw,4rem); letter-spacing:-.07em; line-height:1.03; }h1 span { color:var(--cyan); }.hero>p { color:var(--muted); font-size:clamp(1.05rem,2vw,1.45rem); }
  .workspace { display:grid; grid-template-columns:1.6fr .94fr; gap:1rem; margin-top:.6rem; }.upload-zone,.settings-card,.trust-card,.step-card,.format-table,.faq-item { border:1px solid var(--line); background:var(--surface); box-shadow:var(--shadow); }.upload-zone { min-height:370px; display:grid; place-items:center; border-radius:10px; padding:1rem; }.upload-zone-inner { width:100%; height:100%; min-height:336px; display:grid; align-content:center; justify-items:center; gap:.6rem; border:2px dashed color-mix(in srgb,var(--cyan) 45%,var(--line)); border-radius:9px; color:var(--ink); text-align:center; cursor:pointer; }.upload-zone-inner.drag { background:color-mix(in srgb,var(--cyan) 9%,transparent); border-color:var(--cyan); }.upload-zone-inner input { display:none; }.upload-icon { width:68px; height:55px; color:var(--cyan); }.upload-zone strong { font-size:1.25rem; }.upload-zone small { color:var(--muted); font-size:.92rem; }.image-placeholder { width:88px; height:75px; border:1px solid color-mix(in srgb,var(--cyan) 35%,var(--line)); border-radius:8px; background:linear-gradient(145deg,#e6f7ff,#e5edff); position:relative; box-shadow:0 14px 24px rgba(24,164,224,.17); }.image-placeholder::after { content:""; position:absolute; inset:18px 14px 12px; background:radial-gradient(circle at 27% 26%,#86b8f6 0 6px,transparent 7px),linear-gradient(135deg,transparent 48%,#7eadeb 49% 70%,transparent 71%),linear-gradient(45deg,transparent 39%,#abc8f6 40% 59%,transparent 60%); }
  .settings-card { border-radius:10px; padding:1rem; }.settings-heading { display:flex; align-items:center; justify-content:space-between; gap:.5rem; font-weight:800; font-size:1rem; }.local-state { color:var(--muted); font-size:.7rem; font-weight:500; white-space:nowrap; }.local-state::before { content:""; display:inline-block; width:10px; height:10px; margin-right:.45rem; border-radius:50%; background:#20ca78; box-shadow:0 0 0 4px #dff9ed; vertical-align:-1px; }.preset-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:.48rem; margin:1rem 0; }.preset { appearance:none; min-height:39px; border:1px solid var(--line); border-radius:6px; background-color:var(--surface); color:var(--ink); font-size:.86rem; }.preset.active { color:white; border-color:var(--cyan-deep); background:linear-gradient(135deg,var(--cyan),var(--cyan-deep)); box-shadow:0 6px 15px color-mix(in srgb,var(--cyan) 30%,transparent); }.settings-row { display:grid; grid-template-columns:18px minmax(0,1fr) minmax(4.5rem,6.5rem) minmax(3.5rem,4.5rem); align-items:center; gap:.55rem; padding:.75rem 0; border-top:1px solid var(--line); font-size:.9rem; }.settings-row label { cursor:pointer; white-space:nowrap; }.settings-row input,.settings-row select { width:100%; min-width:0; height:38px; padding:.3rem .55rem; border:1px solid var(--line); border-radius:7px; color:var(--ink); background:var(--surface); }.settings-row input.custom-radio { width:18px; height:18px; margin:0; padding:0; accent-color:var(--cyan-deep); }.field-label { display:flex; align-items:center; justify-content:space-between; padding:.85rem 0; border-top:1px solid var(--line); font-size:.9rem; font-weight:700; }.field-label select { width:52%; height:38px; padding:.3rem .55rem; border:1px solid var(--line); border-radius:7px; color:var(--ink); background:var(--surface); }.jpeg-background-control { display:flex; align-items:center; gap:.55rem; }.jpeg-background-control input { width:44px; height:38px; padding:3px; border:1px solid var(--line); border-radius:9px; background:var(--surface); cursor:pointer; }.jpeg-background-control output { min-width:4.8rem; color:var(--muted); font-size:.78rem; font-variant-numeric:tabular-nums; }.jpeg-warning { margin:-.25rem 0 .75rem; padding:.65rem .75rem; border:1px solid color-mix(in srgb,#d08a00 48%,var(--line)); border-radius:8px; color:color-mix(in srgb,#9a6200 82%,var(--ink)); background:color-mix(in srgb,#ffc857 11%,var(--surface)); font-size:.8rem; line-height:1.5; }:root[data-theme="dark"] .jpeg-warning { color:#ffd98a; }.switch { width:38px; height:22px; padding:2px; border:0; border-radius:99px; background:var(--cyan); }.switch i { width:18px; height:18px; display:block; margin-left:auto; border-radius:50%; background:white; }.primary-action { width:100%; min-height:49px; border:0; border-radius:7px; background:linear-gradient(135deg,var(--cyan),#009ed1); color:white; font-weight:800; box-shadow:0 9px 20px color-mix(in srgb,var(--cyan) 27%,transparent); }.status { margin-top:.8rem; color:var(--muted); font-size:.84rem; }.status.error { color:#bc243d; }.status.success { color:#07814f; }
  :root[data-theme="dark"] .preset:not(.active) { color:#f4f8ff; background:#0d2035; }
  :root[data-theme="dark"] .preset.active { color:#fff; border-color:#2bb9dc; background:#086b8f; }
