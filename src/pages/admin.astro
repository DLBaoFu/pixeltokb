---
import BaseLayout from '../layouts/BaseLayout.astro';
import CmsAdmin from '../components/CmsAdmin';
---
<BaseLayout locale="en" title="Editorial workspace" description="Restricted PixelTokb editorial workspace." noindex internal>
  <CmsAdmin client:load />
</BaseLayout>

<style is:global>
  .cms-shell,.cms-state { max-width:1120px; margin:0 auto; padding:3rem 0 4rem; }.cms-state { min-height:55vh; }.cms-eyebrow { margin:0 0 .4rem; color:var(--cyan-deep); font-size:.76rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }.cms-header,.cms-library-heading,.cms-editor-heading,.cms-editor-actions { display:flex; gap:1rem; align-items:flex-start; justify-content:space-between; }.cms-header { padding-bottom:1.25rem; border-bottom:1px solid var(--line); }.cms-header h1,.cms-state h1 { margin:.1rem 0 .45rem; font-size:clamp(2rem,4vw,3.1rem); letter-spacing:-.055em; overflow-wrap:anywhere; }.cms-header p:not(.cms-eyebrow),.cms-state>p,.cms-library>p,.cms-locales>div>p,.cms-editor-actions p { color:var(--muted); }.cms-grid { display:grid; grid-template-columns:270px minmax(0,1fr); gap:1.25rem; margin-top:1.25rem; }.cms-library,.cms-editor,.cms-locales { padding:1.25rem; border:1px solid var(--line); border-radius:14px; background:var(--surface); box-shadow:var(--shadow); }.cms-library h2,.cms-editor h2,.cms-locales h2 { margin:.1rem 0; font-size:1.25rem; }.cms-library ul { display:grid; gap:.45rem; padding:0; list-style:none; }.cms-library li button { display:grid; width:100%; gap:.15rem; padding:.7rem; border:1px solid var(--line); border-radius:9px; color:var(--ink); background:var(--page); text-align:left; }.cms-library li button:hover { border-color:var(--cyan); }.cms-library li span { color:var(--muted); font-size:.75rem; }.cms-library li strong { overflow-wrap:anywhere; font-size:.87rem; }.cms-empty { padding:.8rem; border:1px dashed var(--line); border-radius:9px; font-size:.88rem; }.cms-filter { display:grid; gap:.38rem; margin:1rem 0; color:var(--muted); font-size:.78rem; font-weight:700; }.cms-filter select { min-height:38px; padding:.45rem .55rem; border:1px solid var(--line); border-radius:8px; color:var(--ink); background:var(--page); font:inherit; }.cms-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.85rem; margin-top:1.15rem; }.cms-fields label,.cms-status { display:grid; gap:.38rem; color:var(--muted); font-size:.82rem; font-weight:700; }.cms-fields input,.cms-fields select,.cms-fields textarea,.cms-status select { width:100%; min-height:42px; padding:.6rem .7rem; border:1px solid var(--line); border-radius:9px; color:var(--ink); background:var(--page); font:inherit; }.cms-fields textarea { min-height:300px; resize:vertical; line-height:1.6; }.cms-wide { grid-column:1 / -1; }.cms-editor-actions { align-items:center; margin-top:1.1rem; padding-top:1rem; border-top:1px solid var(--line); }.cms-editor-actions p { max-width:520px; margin:0; font-size:.82rem; }.cms-button,.cms-secondary { display:inline-flex; min-height:42px; align-items:center; justify-content:center; padding:.6rem .9rem; border-radius:9px; font-weight:800; }.cms-button { border:0; color:#fff; background:linear-gradient(135deg,var(--action),var(--action-end)); }.cms-secondary { border:1px solid var(--line); color:var(--ink); background:var(--surface); }.cms-notice { margin:1.15rem 0 0; padding:.8rem 1rem; border:1px solid color-mix(in srgb,var(--cyan) 40%,var(--line)); border-radius:10px; color:var(--ink); background:color-mix(in srgb,var(--cyan) 6%,var(--surface)); }.cms-error { border-color:#c8505b; color:#8b1828; background:#fff4f5; }.cms-locales { display:grid; grid-template-columns:minmax(0,1fr) minmax(300px,.85fr); gap:1.5rem; margin-top:1.25rem; }.cms-locale-summary { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:1rem; color:var(--muted); font-size:.86rem; }.cms-locale-summary strong { color:#08744a; }.cms-locales ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.5rem; margin:0; padding:0; list-style:none; }.cms-locales li { display:grid; grid-template-columns:1fr auto; gap:.15rem .5rem; padding:.65rem .7rem; border:1px solid var(--line); border-radius:9px; font-size:.82rem; }.cms-locales li span:nth-child(2) { color:var(--muted); font-size:.7rem; }.cms-locales li strong { grid-column:1 / -1; font-size:.73rem; text-transform:capitalize; }.cms-locales [data-state="published"] { color:#08744a; }.cms-locales [data-state="needs-review"] { color:#96630b; }:root[data-theme="dark"] .cms-error { color:#ffbcc3; background:#351722; } @media (max-width:800px) { .cms-grid,.cms-locales { grid-template-columns:1fr; }.cms-header,.cms-editor-actions { flex-direction:column; }.cms-locales ul { grid-template-columns:1fr; } } @media (max-width:620px) { .cms-shell,.cms-state { padding:1.5rem .75rem 2.5rem; }.cms-fields { grid-template-columns:1fr; }.cms-wide { grid-column:auto; } }
</style>
