---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const sections = {
  compress: { title: '图片压缩', intro: '可以为 JPEG、PNG 或 WebP 设置精确字节目标，也可以对一个或最多 20 个静态 PNG 进行经过校验的无损优化。', links: [['PNG 无损优化', '在本地优化 PNG，并将通过校验且更小的结果单独下载或打包为 ZIP。', '/zh-cn/compress-png/'], ['10–100 KB', '适合严格的表单和小图片限制。', '/zh-cn/compress-image/?preset=10-100kb'], ['200–500 KB', '适合中等大小的照片和文档。', '/zh-cn/compress-image/?preset=200-500kb'], ['500 KB–1 MB', '将较大图片控制在 1 MB 内。', '/zh-cn/compress-image/?preset=500kb-1mb'], ['2–5 MB', '在较高容量上限下保留更多细节。', '/zh-cn/compress-image/?preset=2mb-5mb']] },
  resize: { title: '缩放和裁剪', intro: '规划比例、计算打印像素密度、调整图片像素尺寸、裁剪画面区域，或按真实文件大小要求处理签名图片。', links: [['打印尺寸照片调整', '用毫米或英寸设定打印尺寸，并验证 JPEG 或 PNG 的 DPI 元数据。', '/zh-cn/photo-resizer/'], ['图片宽高比计算器', '化简宽高比例，并计算匹配的像素边长。', '/zh-cn/aspect-ratio-calculator/'], ['PPI 计算器', '根据计划打印尺寸计算每英寸像素数，不修改图片文件。', '/zh-cn/ppi-calculator/'], ['缩放图片', '设置精确宽高，再选择适配、填充或拉伸。', '/zh-cn/resize-image/'], ['裁剪图片', '直接选取裁剪区域，或通过像素坐标微调。', '/zh-cn/crop-image/'], ['签名图片缩放', '裁剪签名区域，设置像素，并核对最终 JPEG 字节限制。', '/zh-cn/signature-resizer/'], ['签名图片压缩', '按所选签名上传大小限制处理白底 JPEG。', '/zh-cn/signature-compressor/']] },
  forms: { title: '签名和表单图片', intro: '在上传前本地准备签名图片或打印尺寸照片，并自行核对尺寸和实际文件信息。', links: [['签名图片缩放', '裁剪签名区域，设置像素，并核对白底 JPEG 的实际字节限制。', '/zh-cn/signature-resizer/'], ['签名图片压缩', '无需将图片上传到服务器，即可按所选限制处理白底 JPEG。', '/zh-cn/signature-compressor/'], ['打印尺寸照片调整', '用毫米或英寸设定物理尺寸，并验证导出 JPEG 或 PNG 的 DPI 元数据。', '/zh-cn/photo-resizer/'], ['图片大小检查', '上传前查看字节、像素尺寸、格式、透明度和已有元数据。', '/zh-cn/image-size-checker/']] },
  inspect: { title: '图片信息检查', intro: '上传或发送图片前，先查看文件本身和打印元数据。', links: [['图片大小检查', '查看字节、KB 与 KiB、像素尺寸、比例和透明度。', '/zh-cn/image-size-checker/'], ['DPI 检查', '读取图片文件中实际包含的打印分辨率元数据。', '/zh-cn/image-dpi-checker/']] }
};
export function getStaticPaths() { return ['compress', 'resize', 'forms', 'inspect'].map((category) => ({ params: { category }, props: { category } })); }
const section = sections[Astro.props.category as keyof typeof sections];
---
<BaseLayout locale="zh-cn" title={section.title} description={section.intro}><div class="directory-page"><div class="hero"><p class="eyebrow">PIXELTOKB · 工具</p><h1>{section.title}</h1><p>{section.intro}</p></div><div class="tool-card-grid">{section.links.map(([title, text, href]) => <a class="tool-card" href={href}><span class="directory-icon" aria-hidden="true">✳</span><h2>{title}</h2><p>{text}</p><span class="card-action">打开工具 <span aria-hidden="true">→</span></span></a>)}</div><div class="directory-section"><p><a href="/zh-cn/tools/">← 全部图片工具</a></p></div></div></BaseLayout>
