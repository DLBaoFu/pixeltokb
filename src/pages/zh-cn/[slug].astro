---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompressionTool from '../../components/CompressionTool';
import ResizeTool from '../../components/ResizeTool';
import CropTool from '../../components/CropTool';
import ImageInfoTool from '../../components/ImageInfoTool';
import FoundationContent from '../../components/FoundationContent.astro';
import ToolSupportingContent from '../../components/ToolSupportingContent.astro';
import CompressionRangeNotes from '../../components/CompressionRangeNotes.astro';
import PngOptimizationPage from '../../components/PngOptimizationPage.astro';
import SignatureTool from '../../components/SignatureTool';
import AspectRatioCalculator from '../../components/AspectRatioCalculator';
import PpiCalculator from '../../components/PpiCalculator';
import PhotoResizer from '../../components/PhotoResizer';
import BackgroundRemover from '../../components/BackgroundRemover';
import { compressionGroupForSlug } from '../../lib/compression-groups';
import { pngCopy } from '../../lib/png/content';

export function getStaticPaths() {
  const slugs = ['about', 'contact', 'privacy', 'terms', 'cookies', 'editorial-policy', 'how-it-works', 'faq', 'changelog', 'compress-image', 'compress-png', 'signature-resizer', 'signature-compressor', 'signature-background-remover', 'aspect-ratio-calculator', 'ppi-calculator', 'photo-resizer', 'resize-image', 'crop-image', 'image-size-checker', 'image-dpi-checker'];
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const group = compressionGroupForSlug(slug);
const isTool = Boolean(group);
const isPngTool = slug === 'compress-png';
const isSignatureResizer = slug === 'signature-resizer';
const isSignatureCompressor = slug === 'signature-compressor';
const isBackgroundRemover = slug === 'signature-background-remover';
const isPhotoResizer = slug === 'photo-resizer';
const isAspectRatioCalculator = slug === 'aspect-ratio-calculator';
const isPpiCalculator = slug === 'ppi-calculator';
const isResizeTool = slug === 'resize-image';
const isCropTool = slug === 'crop-image';
const isSizeTool = slug === 'image-size-checker';
const isDpiTool = slug === 'image-dpi-checker';
const supportTool = isTool ? 'compress' : isResizeTool ? 'resize' : isCropTool ? 'crop' : isSizeTool ? 'size' : isDpiTool ? 'dpi' : null;
const content: Record<string, { title: string; body: string }> = {
  tools: { title: '图片工具', body: '使用 pixeltokb 压缩图片、缩放像素、裁剪图片并检查文件元数据。所有处理都在浏览器本地完成。' },
  blog: { title: 'pixeltokb 博客', body: '了解图片字节、像素、DPI 和上传限制的实用指南。' },
  about: { title: '关于 PixelTokb', body: 'PixelTokb 提供在浏览器中运行的图片压缩、缩放、裁剪和信息检查工具。图片处理保留在你的设备上。' },
  contact: { title: '联系 PixelTokb', body: '如需报告内容错误、提出隐私请求或反馈站点问题，可以通过电子邮件联系 PixelTokb 团队。' },
  privacy: { title: '隐私政策', body: '本政策说明图片本地处理、浏览器偏好、托管访问数据、电子邮件，以及未来启用广告时的数据处理方式。' },
  terms: { title: '使用条款', body: '本条款说明 PixelTokb 的允许用途、用户责任、服务限制和责任边界。' },
  cookies: { title: 'Cookie 与隐私设置', body: 'PixelTokb 目前只在本地保存主题和语言偏好；广告和非必要跟踪仍处于关闭状态。' },
  'editorial-policy': { title: '编辑政策', body: 'PixelTokb 发布经过审核、可以复现的图片指南，并提供真实样例、限制说明和纠错流程。' },
  'how-it-works': { title: '工作原理', body: '浏览器 Worker 会解码图片、尝试支持的编码方式，并检查生成文件的实际字节数。处理过程在本地完成。' },
  faq: { title: '常见问题', body: 'KB 表示 1000 字节，KiB 表示 1024 字节。目标大小根据实际字节数检查，而不是四舍五入后的显示值。' },
  changelog: { title: 'PixelToKB 产品更新记录', body: '记录 PixelToKB 新增图片工具、问题修复和面向用户的产品改进。' },
  'authors/editor': { title: '编辑者信息', body: '此页面将在站点设置完成后展示真实编辑者信息。' },
  'compress-image': { title: '在线将图片压缩到精确 KB', body: '为 JPEG、PNG 或 WebP 图片设置文件体积目标，并在下载前核对精确字节数。如果表单要求把图片调整到精确 KB，这里控制的是文件大小；如果需要精确像素尺寸，请使用图片缩放工具。' },
  'compress-jpg': { title: '压缩 JPG 图片', body: '为 JPEG 图片设置精确的 KB 或 KiB 目标。达到目标后才会提供可下载文件。' },
  'resize-image': { title: '按像素缩放图片', body: '设置确切的输出宽高。可完整显示图片并留白、铺满画布并居中裁剪，或拉伸图片。' },
  'signature-resizer': { title: '在线调整签名图片尺寸', body: '裁剪签名区域，设置精确输出像素，并在本地检查实际字节数后下载白底 JPEG。' },
  'signature-compressor': { title: '在线压缩签名图片', body: '为签名图片设置文件大小限制，在本地裁剪并按精确像素导出白底 JPEG。' },
  'signature-background-remover': { title: '在线去除单色签名背景', body: '根据左上角取样颜色和本地阈值，让均匀纸张或白色签名背景变为透明；这不是 AI 主体抠图。' },
  'aspect-ratio-calculator': { title: '图片宽高比计算器', body: '将像素宽高化为最简比例，并按新的宽度或高度计算匹配边长；无需上传图片。' },
  'ppi-calculator': { title: '打印尺寸 PPI 计算器', body: '根据图片像素和计划打印尺寸计算横向、纵向与对角线每英寸像素数；无需上传图片。' },
  'crop-image': { title: '在线裁剪图片', body: '在预览区拖选裁剪范围，也可以输入精确的像素坐标。图片仅在本设备处理。' },
  'image-size-checker': { title: '检查图片大小和尺寸', body: '查看精确字节数、KB 与 KiB、像素尺寸、宽高比和透明度信息。' },
  'image-dpi-checker': { title: '检查图片 DPI', body: '读取可用的 DPI 元数据，并查看图片像素尺寸。并非所有图片都包含 DPI 信息。' }
};
const toolTitle = group ? '按目标大小压缩图片' : (content[slug]?.title ?? '按目标大小压缩图片');
const info = isPngTool ? { title: pngCopy['zh-cn'].pageTitle, body: pngCopy['zh-cn'].pageDescription } : content[slug] ?? { title: toolTitle, body: '在线将静态 JPEG、PNG 或 WebP 图片压缩到 1 KB 至 5 MB 的目标。处理全程在浏览器本地完成，无需上传。' };
---
<BaseLayout locale="zh-cn" title={info.title} description={info.body} application={Boolean(supportTool) || isPngTool || isSignatureResizer || isSignatureCompressor || isBackgroundRemover || isAspectRatioCalculator || isPpiCalculator || isPhotoResizer}>
  <div class="detail-page">{isTool ? <><div class="hero"><p class="eyebrow">图片压缩</p><h1>{info.title}</h1><p>{info.body} 图片仅在本设备处理。</p></div><CompressionTool client:load locale="zh-cn" group={group} /><CompressionRangeNotes locale="zh-cn" /><section class="cards"><h2>支持格式和限制</h2><p>工具支持静态 JPEG、PNG 和 WebP 图片。目标大小可从 1 KB 到 5 MB 自定义，文件最大 20 MB，解码后最多 4000 万像素。动态 PNG 和 WebP 会被明确拒绝，请先导出静态画面。选择自动或 WebP 时会保留透明度；主动选择 JPEG 时，透明区域会填充为所选背景色。</p></section></> : isPngTool ? <PngOptimizationPage locale="zh-cn" /> : isBackgroundRemover ? <><div class="hero"><p class="eyebrow">签名背景处理</p><h1>{info.title}</h1><p>{info.body}</p></div><BackgroundRemover client:load locale="zh-cn" /><section class="cards"><h2>适合使用阈值的场景</h2><p>颜色均匀的纸张或白色背景可以通过比较角落取样颜色来移除。阴影、纹理纸张、头发、重叠物体和不均匀光照可能需要其他方法；使用前请检查透明 PNG。</p></section></> : isPhotoResizer ? <><div class="hero"><p class="eyebrow">打印尺寸照片调整</p><h1>{info.title}</h1><p>{info.body}</p></div><PhotoResizer client:load locale="zh-cn" /><section class="cards"><h2>物理尺寸不等于审核通过</h2><p>请按接收平台要求设置尺寸和 DPI。本工具会验证导出 JPEG 或 PNG 的密度标签，但不保证护照、签证、证件照或表单资格。</p></section></> : isSignatureResizer || isSignatureCompressor ? <><div class="hero"><p class="eyebrow">签名图片处理</p><h1>{info.title}</h1><p>{info.body}</p></div><SignatureTool client:load locale="zh-cn" variant={isSignatureResizer ? 'resize' : 'compress'} /><section class="cards"><h2>以接收平台的当前规则为准</h2><p>请按接收平台实际要求设置裁剪区域、像素尺寸和文件大小。本工具使用白底 JPEG 并检查最终字节数，但不保证任何政府、考试、银行或表单要求。</p></section></> : isAspectRatioCalculator ? <><div class="hero"><p class="eyebrow">尺寸规划</p><h1>{info.title}</h1><p>{info.body}</p></div><AspectRatioCalculator client:load locale="zh-cn" /><section class="cards"><h2>缩放前先确认比例</h2><p>宽高比说明宽度与高度之间的关系。无法得到整数像素时，计算器会显示四舍五入结果；导出图片前，请再确认接收平台要求的准确尺寸。</p></section></> : isPpiCalculator ? <><div class="hero"><p class="eyebrow">打印规划</p><h1>{info.title}</h1><p>{info.body}</p></div><PpiCalculator client:load locale="zh-cn" /><section class="cards"><h2>PPI 不是文件内 DPI</h2><p>此工具根据选定打印尺寸估算每英寸像素数，不读取图片文件元数据，也不会写入 DPI；如需读取文件已有元数据，请使用 DPI 检查工具。</p></section></> : isResizeTool ? <><div class="hero"><p class="eyebrow">像素缩放</p><h1>{info.title}</h1><p>{info.body}</p></div><ResizeTool client:load locale="zh-cn" /><section class="cards"><h2>浏览器缩放原理</h2><p>原图会在浏览器 Worker 中解码并绘制到新画布，再在本地编码并提供下载。透明背景会在 PNG 或 WebP 导出中保留。</p></section></> : isCropTool ? <><div class="hero"><p class="eyebrow">图片裁剪</p><h1>{info.title}</h1><p>{info.body}</p></div><CropTool client:load locale="zh-cn" /><section class="cards"><h2>如何裁剪</h2><p>拖动鼠标或触屏设置裁剪区域，再通过可键盘操作的像素字段微调左侧、顶部、宽度和高度。</p></section></> : isSizeTool || isDpiTool ? <><div class="hero"><p class="eyebrow">图片检查</p><h1>{info.title}</h1><p>{info.body} 文件仅在浏览器本地读取。</p></div><ImageInfoTool client:load locale="zh-cn" mode={isSizeTool ? 'size' : 'dpi'} /><section class="cards"><h2>{isDpiTool ? '了解 DPI' : '支持的图片信息'}</h2><p>{isDpiTool ? 'DPI 是打印元数据，不会改变图片像素尺寸。有些文件不包含 DPI 信息。' : '支持最大 20 MB、4000 万像素的静态 JPEG、PNG 和 WebP 图片。'}</p></section></> : <FoundationContent locale="zh-cn" slug={slug} title={info.title} intro={info.body} />}{supportTool && <ToolSupportingContent locale="zh-cn" tool={supportTool} />}</div>
</BaseLayout>
