---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompressionTool from '../../components/CompressionTool';
import ResizeTool from '../../components/ResizeTool';
import CropTool from '../../components/CropTool';
import ImageInfoTool from '../../components/ImageInfoTool';
import FoundationContent from '../../components/FoundationContent.astro';
import ToolSupportingContent from '../../components/ToolSupportingContent.astro';
import { compressionGroupForSlug, compressionGroups } from '../../lib/compression-groups';

export function getStaticPaths() {
  const slugs = ['about', 'contact', 'privacy', 'terms', 'cookies', 'editorial-policy', 'how-it-works', 'faq', 'changelog', 'compress-image', 'compress-image-200kb-to-500kb', 'compress-image-500kb-to-1mb', 'compress-image-2mb-to-5mb', 'resize-image', 'crop-image', 'image-size-checker', 'image-dpi-checker'];
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const group = compressionGroupForSlug(slug);
const isTool = Boolean(group);
const isResizeTool = slug === 'resize-image';
const isCropTool = slug === 'crop-image';
const isSizeTool = slug === 'image-size-checker';
const isDpiTool = slug === 'image-dpi-checker';
const supportTool = isTool ? 'compress' : isResizeTool ? 'resize' : isCropTool ? 'crop' : isSizeTool ? 'size' : isDpiTool ? 'dpi' : null;
const content: Record<string, { title: string; body: string }> = {
  tools: { title: '图片工具', body: '使用 pixeltokb 压缩图片、缩放像素、裁剪图片并检查文件元数据。所有处理都在浏览器本地完成。' },
  blog: { title: 'pixeltokb 博客', body: '了解图片字节、像素、DPI 和上传限制的实用指南。' },
  about: { title: '关于 PixelTokb', body: 'PixelTokb 提供在浏览器中运行的图片压缩、缩放、裁剪和信息检查工具。图片处理保留在你的设备上。' },
  contact: { title: '联系 PixelTokb', body: '如需报告内容错误、提出隐私请求或反馈站点问题，可以通过电子邮件联系 PixelTokb 团队。' },
  privacy: { title: '隐私政策', body: '本政策说明图片本地处理、浏览器偏好、托管访问数据、电子邮件，以及未来启用广告时的数据处理方式。' },
  terms: { title: '使用条款', body: '本条款说明 PixelTokb 的允许用途、用户责任、服务限制和责任边界。' },
  cookies: { title: 'Cookie 与隐私设置', body: 'PixelTokb 目前只在本地保存主题和语言偏好；广告和非必要跟踪仍处于关闭状态。' },
  'editorial-policy': { title: '编辑政策', body: 'PixelTokb 发布经过审核、可以复现的图片指南，并提供真实样例、限制说明和纠错流程。' },
  'how-it-works': { title: '工作原理', body: '浏览器 Worker 会解码图片、尝试支持的编码方式，并检查生成文件的实际字节数。处理过程在本地完成。' },
  faq: { title: '常见问题', body: 'KB 表示 1000 字节，KiB 表示 1024 字节。目标大小根据实际字节数检查，而不是四舍五入后的显示值。' },
  changelog: { title: '更新记录', body: '这里记录 PixelTokb 工具、内容、语言与发布准备情况中经过验证的变化。' },
  'authors/editor': { title: '编辑者信息', body: '此页面将在站点设置完成后展示真实编辑者信息。' },
  'compress-image': { title: '按目标大小压缩图片', body: '选择一个文件体积目标，压缩 JPEG、PNG 或 WebP 图片，并在下载前核实实际字节数。' },
  'compress-jpg': { title: '压缩 JPG 图片', body: '为 JPEG 图片设置精确的 KB 或 KiB 目标。达到目标后才会提供可下载文件。' },
  'resize-image': { title: '按像素缩放图片', body: '设置确切的输出宽高。可完整显示图片并留白、铺满画布并居中裁剪，或拉伸图片。' },
  'crop-image': { title: '在线裁剪图片', body: '在预览区拖选裁剪范围，也可以输入精确的像素坐标。图片仅在本设备处理。' },
  'image-size-checker': { title: '检查图片大小和尺寸', body: '查看精确字节数、KB 与 KiB、像素尺寸、宽高比和透明度信息。' },
  'image-dpi-checker': { title: '检查图片 DPI', body: '读取可用的 DPI 元数据，并查看图片像素尺寸。并非所有图片都包含 DPI 信息。' }
};
const toolTitle = group ? `压缩图片到 ${compressionGroups[group].label}` : (content[slug]?.title ?? '按目标大小压缩图片');
const info = content[slug] ?? { title: toolTitle, body: `在线将静态 JPEG、PNG 或 WebP 图片压缩到经过实际字节数检查的 ${compressionGroups[group!].label} 目标。处理全程在浏览器本地完成，无需上传。` };
---
<BaseLayout locale="zh-cn" title={info.title} description={info.body} application={Boolean(supportTool)}>
  <div class="detail-page">{isTool ? <><div class="hero"><p class="eyebrow">图片压缩</p><h1>{info.title}</h1><p>{info.body} 图片仅在本设备处理。</p></div><CompressionTool client:load locale="zh-cn" group={group} /><section class="cards"><h2>支持格式和限制</h2><p>工具支持静态 JPEG、PNG 和 WebP 图片。文件最大 20 MB，解码后最多 4000 万像素。动态 PNG 和 WebP 会被明确拒绝，请先导出静态画面。选择自动或 WebP 时会保留透明度；主动选择 JPEG 时，透明区域会填充为所选背景色。</p></section></> : isResizeTool ? <><div class="hero"><p class="eyebrow">像素缩放</p><h1>{info.title}</h1><p>{info.body}</p></div><ResizeTool client:load locale="zh-cn" /><section class="cards"><h2>浏览器缩放原理</h2><p>原图会在浏览器 Worker 中解码并绘制到新画布，再在本地编码并提供下载。透明背景会在 PNG 或 WebP 导出中保留。</p></section></> : isCropTool ? <><div class="hero"><p class="eyebrow">图片裁剪</p><h1>{info.title}</h1><p>{info.body}</p></div><CropTool client:load locale="zh-cn" /><section class="cards"><h2>如何裁剪</h2><p>拖动鼠标或触屏设置裁剪区域，再通过可键盘操作的像素字段微调左侧、顶部、宽度和高度。</p></section></> : isSizeTool || isDpiTool ? <><div class="hero"><p class="eyebrow">图片检查</p><h1>{info.title}</h1><p>{info.body} 文件仅在浏览器本地读取。</p></div><ImageInfoTool client:load locale="zh-cn" mode={isSizeTool ? 'size' : 'dpi'} /><section class="cards"><h2>{isDpiTool ? '了解 DPI' : '支持的图片信息'}</h2><p>{isDpiTool ? 'DPI 是打印元数据，不会改变图片像素尺寸。有些文件不包含 DPI 信息。' : '支持最大 20 MB、4000 万像素的静态 JPEG、PNG 和 WebP 图片。'}</p></section></> : <FoundationContent locale="zh-cn" slug={slug} title={info.title} intro={info.body} />}{supportTool && <ToolSupportingContent locale="zh-cn" tool={supportTool} />}</div>
</BaseLayout>
