---
import GuideArticle from '../../../components/GuideArticle.astro';
import { guides } from '../../../lib/guide-content';
export function getStaticPaths() { return guides['zh-cn'].map(({ slug }) => ({ params: { slug }, props: { slug } })); }
const { slug } = Astro.props;
---
<GuideArticle locale="zh-cn" slug={slug} />
