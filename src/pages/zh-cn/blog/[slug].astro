---
import GuideArticle from '../../../components/GuideArticle.astro';
import { blogRouteSlugs } from '../../../lib/blog-content';
export function getStaticPaths() { return blogRouteSlugs('zh-cn').map((slug) => ({ params: { slug }, props: { slug } })); }
const { slug } = Astro.props;
---
<GuideArticle locale="zh-cn" slug={slug} />
