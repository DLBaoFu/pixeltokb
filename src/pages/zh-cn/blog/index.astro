---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const articles = [
  { slug: 'compress-without-changing-dimensions', category: '压缩基础', title: '不改变像素尺寸，如何压缩图片？', text: '了解画质设置的作用、何时需要缩小像素尺寸，以及如何核对最终文件。', featured: true },
  { slug: 'why-image-wont-fit-50kb', category: '问题排查', title: '为什么图片可能无法压到 50 KB？', text: '噪点、细节、透明度和像素数量，都会影响文件能缩小到什么程度。' },
  { slug: 'kb-vs-kib', category: '文件大小', title: 'KB 与 KiB 有什么区别？', text: '十进制 KB 和二进制 KiB 的区别，以及精确字节数为何重要。' },
  { slug: 'check-image-size-and-dpi', category: '图片元数据', title: '如何检查图片大小、像素与 DPI？', text: '分别理解文件字节数、像素尺寸、宽高比和打印元数据。' }
  ,{ slug: 'compress-image-to-100kb', category: '上传案例', title: '如何将图片压缩到 100 KB 用于上传？', text: '从检查原图、按字节目标处理，到核对保存文件的实用流程。' }
];
---
<BaseLayout locale="zh-cn" title="图片指南与知识" description="了解图片压缩、上传限制、像素尺寸与 DPI 的实用指南。">
  <div class="directory-page">
    <div class="hero"><p class="eyebrow">PIXELTOKB · 图片知识库</p><h1>图片上传问题，讲清楚就好。</h1><p>关于文件大小、画质、尺寸和元数据的实用指南。每篇内容都力求清楚、可验证，不靠猜测。</p></div>
    <div class="category-nav"><a href="/zh-cn/blog/category/tutorials/">图片教程</a><a href="/zh-cn/blog/category/troubleshooting/">问题排查</a></div>
    <section class="editorial-grid" aria-label="图片指南">{articles.map((article) => <a class:list={['article-card', article.featured && 'featured']} href={`/zh-cn/blog/${article.slug}/`}><span class="directory-icon" aria-hidden="true">{article.featured ? '↘' : '✳'}</span><span class="article-category">{article.category}</span><h2>{article.title}</h2><p>{article.text}</p><span class="card-action">阅读全文 <span aria-hidden="true">→</span></span></a>)}</section>
    <section class="directory-section"><h2>从了解图片开始</h2><p>先用本地工具查看文件信息，再根据实际上传要求选择下一步。</p><div class="preset-links"><a class="preset-link" href="/zh-cn/image-size-checker/"><strong>检查文件大小</strong><span>查看字节数与尺寸 →</span></a><a class="preset-link" href="/zh-cn/compress-image/"><strong>压缩图片</strong><span>选择精确目标 →</span></a></div></section>
  </div>
</BaseLayout>
