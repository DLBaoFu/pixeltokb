import BaseLayout from '../../../layouts/BaseLayout.astro';
const articles = [
  { slug: 'compress-without-changing-dimensions', category: '壓縮基礎', title: '不改變像素尺寸，如何壓縮圖片？', text: '了解畫質設定的作用、何時需要縮小像素尺寸，以及如何核對最終檔案。', featured: true },
  { slug: 'why-image-wont-fit-50kb', category: '問題排解', title: '為什麼圖片可能無法壓到 50 KB？', text: '雜訊、細節、透明度和像素數量，都會影響檔案能縮小到什麼程度。' },
  { slug: 'kb-vs-kib', category: '檔案大小', title: 'KB 與 KiB 有什麼不同？', text: '十進位 KB 和二進位 KiB 的差異，以及精確位元組數為何重要。' },
  { slug: 'check-image-size-and-dpi', category: '圖片中繼資料', title: '如何檢查圖片大小、像素與 DPI？', text: '分別理解檔案位元組數、像素尺寸、長寬比和列印中繼資料。' }
