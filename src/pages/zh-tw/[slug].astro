---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompressionTool from '../../components/CompressionTool';
import ResizeTool from '../../components/ResizeTool';
import CropTool from '../../components/CropTool';
import ImageInfoTool from '../../components/ImageInfoTool';
import FoundationContent from '../../components/FoundationContent.astro';
import ToolSupportingContent from '../../components/ToolSupportingContent.astro';
import CompressionRangeNotes from '../../components/CompressionRangeNotes.astro';
import PngOptimizationPage from '../../components/PngOptimizationPage.astro';
import SignatureTool from '../../components/SignatureTool';
import AspectRatioCalculator from '../../components/AspectRatioCalculator';
import PpiCalculator from '../../components/PpiCalculator';
import PhotoResizer from '../../components/PhotoResizer';
import BackgroundRemover from '../../components/BackgroundRemover';
import { compressionGroupForSlug } from '../../lib/compression-groups';
import { toTraditional } from '../../lib/traditionalize';
import { pngCopy } from '../../lib/png/content';

export function getStaticPaths() {
  const slugs = ['about', 'contact', 'privacy', 'terms', 'cookies', 'editorial-policy', 'how-it-works', 'faq', 'changelog', 'compress-image', 'compress-png', 'signature-resizer', 'signature-compressor', 'signature-background-remover', 'aspect-ratio-calculator', 'ppi-calculator', 'photo-resizer', 'resize-image', 'crop-image', 'image-size-checker', 'image-dpi-checker'];
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}
const { slug } = Astro.props;
const group = compressionGroupForSlug(slug);
const isTool = Boolean(group);
const isPngTool = slug === 'compress-png';
const isSignatureResizer = slug === 'signature-resizer';
const isSignatureCompressor = slug === 'signature-compressor';
const isBackgroundRemover = slug === 'signature-background-remover';
const isPhotoResizer = slug === 'photo-resizer';
const isAspectRatioCalculator = slug === 'aspect-ratio-calculator';
const isPpiCalculator = slug === 'ppi-calculator';
const isResizeTool = slug === 'resize-image';
const isCropTool = slug === 'crop-image';
const isSizeTool = slug === 'image-size-checker';
const isDpiTool = slug === 'image-dpi-checker';
const supportTool = isTool ? 'compress' : isResizeTool ? 'resize' : isCropTool ? 'crop' : isSizeTool ? 'size' : isDpiTool ? 'dpi' : null;
const presets = {
  about: ['關於 PixelTokb', 'PixelTokb 提供在瀏覽器中執行的圖片壓縮、縮放、裁切與資訊檢查工具。圖片處理保留在你的裝置上。'],
  contact: ['聯絡 PixelTokb', '如需回報內容錯誤、提出隱私請求或提供網站意見，可以透過電子郵件聯絡 PixelTokb 團隊。'],
  privacy: ['隱私權政策', '本政策說明圖片本機處理、瀏覽器偏好、託管存取資料、電子郵件，以及日後啟用廣告時的資料處理方式。'],
  terms: ['使用條款', '本條款說明 PixelTokb 的允許用途、使用者責任、服務限制與責任界線。'],
  cookies: ['Cookie 與隱私設定', 'PixelTokb 目前只在本機儲存主題與語言偏好；廣告與非必要追蹤仍處於停用狀態。'],
  'editorial-policy': ['編輯政策', 'PixelTokb 發布經過審核、可重現的圖片指南，並提供真實範例、限制說明與更正流程。'],
  'how-it-works': ['運作方式', '瀏覽器 Worker 會解碼圖片、嘗試支援的編碼方式，並檢查產生檔案的實際位元組數。處理全程在本機完成。'],
  faq: ['常見問題', 'KB 代表 1,000 位元組，KiB 代表 1,024 位元組。目標大小依實際位元組數檢查，而不是四捨五入後的顯示值。'],
  changelog: ['PixelToKB 產品更新記錄', '記錄 PixelToKB 新增圖片工具、問題修正與面向使用者的產品改進。'],
  'compress-image': ['線上將圖片壓縮到精確 KB', '為 JPEG、PNG 或 WebP 圖片設定檔案容量目標，並在下載前核對精確位元組數。如果表單要求將圖片調整到精確 KB，這裡控制的是檔案大小；如果需要精確像素尺寸，請使用圖片縮放工具。'],
  'compress-jpg': ['壓縮 JPG 圖片', '為 JPEG 圖片設定精確的 KB 或 KiB 目標。達到目標後才會提供下載檔案。'],
  'resize-image': ['依像素縮放圖片', '設定確切的輸出寬高。可完整顯示圖片並留白、填滿畫布並置中裁切，或拉伸圖片。'],
  'signature-resizer': ['線上調整簽名圖片尺寸', '裁切簽名區域，設定確切輸出像素，並在本機檢查實際位元組數後下載白底 JPEG。'],
  'signature-compressor': ['線上壓縮簽名圖片', '為簽名圖片設定檔案大小限制，在本機裁切並依精確像素匯出白底 JPEG。'],
  'signature-background-remover': ['線上移除單色簽名背景', '依左上角取樣顏色與本機閾值，讓均勻紙張或白色簽名背景變透明；這不是 AI 主體去背。'],
  'aspect-ratio-calculator': ['圖片長寬比計算器', '將像素寬高化為最簡比例，並依新的寬度或高度計算相符邊長；無需上傳圖片。'],
  'ppi-calculator': ['列印尺寸 PPI 計算器', '依圖片像素與預計列印尺寸計算橫向、直向與對角線每英吋像素數；無需上傳圖片。'],
  'crop-image': ['線上裁切圖片', '在預覽區拖曳選取裁切範圍，也可以輸入精確的像素座標。圖片只會在本機處理。'],
  'image-size-checker': ['檢查圖片大小和尺寸', '查看精確位元組數、KB 與 KiB、像素尺寸、長寬比和透明度資訊。'],
  'image-dpi-checker': ['檢查圖片 DPI', '讀取可用的 DPI 中繼資料，並查看圖片像素尺寸。並非所有圖片都包含 DPI 資訊。']
} as const;
const [rawTitle, rawBody] = presets[slug as keyof typeof presets] ?? [group ? '依目標大小壓縮圖片' : 'pixeltokb 圖片工具', group ? '線上將靜態 JPEG、PNG 或 WebP 圖片壓縮到 1 KB 至 5 MB 的目標。處理全程在瀏覽器本機完成，無需上傳。' : '選擇目標大小、加入圖片，並下載已依實際位元組數檢查的結果。'];
const title = isPngTool ? pngCopy['zh-tw'].pageTitle : toTraditional(rawTitle);
const body = isPngTool ? pngCopy['zh-tw'].pageDescription : toTraditional(rawBody);
---
<BaseLayout locale="zh-tw" title={title} description={body} application={Boolean(supportTool) || isPngTool || isSignatureResizer || isSignatureCompressor || isBackgroundRemover || isAspectRatioCalculator || isPpiCalculator || isPhotoResizer}>
  <div class="detail-page">{isTool ? <><div class="hero"><p class="eyebrow">圖片壓縮</p><h1>{title}</h1><p>{body} 圖片只在本機處理。</p></div><CompressionTool client:load locale="zh-tw" group={group} /><CompressionRangeNotes locale="zh-tw" /><section class="cards"><h2>支援格式和限制</h2><p>工具支援靜態 JPEG、PNG 和 WebP 圖片。目標大小可由 1 KB 到 5 MB 自訂，檔案最大 20 MB，解碼後最多 4,000 萬像素。動態 PNG 和 WebP 會被明確拒絕，請先匯出靜態畫面。選擇自動或 WebP 時會保留透明度；主動選擇 JPEG 時，透明區域會填充為所選背景色。</p></section></> : isPngTool ? <PngOptimizationPage locale="zh-tw" /> : isBackgroundRemover ? <><div class="hero"><p class="eyebrow">簽名背景處理</p><h1>{title}</h1><p>{body}</p></div><BackgroundRemover client:load locale="zh-tw" /><section class="cards"><h2>適合使用閾值的情境</h2><p>顏色均勻的紙張或白色背景可以透過比較角落取樣顏色來移除。陰影、紋理紙張、頭髮、重疊物體和不均勻光線可能需要其他方法；使用前請檢查透明 PNG。</p></section></> : isPhotoResizer ? <><div class="hero"><p class="eyebrow">列印尺寸相片調整</p><h1>{title}</h1><p>{body}</p></div><PhotoResizer client:load locale="zh-tw" /><section class="cards"><h2>實體尺寸不等於審核通過</h2><p>請依接收平台要求設定尺寸和 DPI。本工具會驗證匯出 JPEG 或 PNG 的密度標籤，但不保證護照、簽證、證件照或表單資格。</p></section></> : isSignatureResizer || isSignatureCompressor ? <><div class="hero"><p class="eyebrow">簽名圖片處理</p><h1>{title}</h1><p>{body}</p></div><SignatureTool client:load locale="zh-tw" variant={isSignatureResizer ? 'resize' : 'compress'} /><section class="cards"><h2>請以接收平台目前規則為準</h2><p>請依接收平台實際要求設定裁切區域、像素尺寸與檔案大小。本工具使用白底 JPEG 並檢查最終位元組數，但不保證任何政府、考試、銀行或表單要求。</p></section></> : isAspectRatioCalculator ? <><div class="hero"><p class="eyebrow">尺寸規劃</p><h1>{title}</h1><p>{body}</p></div><AspectRatioCalculator client:load locale="zh-tw" /><section class="cards"><h2>縮放前先確認比例</h2><p>長寬比說明寬度與高度的關係。無法得到整數像素時，計算器會顯示四捨五入結果；匯出圖片前，請再確認接收平台要求的準確尺寸。</p></section></> : isPpiCalculator ? <><div class="hero"><p class="eyebrow">列印規劃</p><h1>{title}</h1><p>{body}</p></div><PpiCalculator client:load locale="zh-tw" /><section class="cards"><h2>PPI 不是檔案內 DPI</h2><p>此工具依選定列印尺寸估算每英吋像素數，不讀取圖片檔案中繼資料，也不會寫入 DPI；若要讀取檔案已有中繼資料，請使用 DPI 檢查工具。</p></section></> : isResizeTool ? <><div class="hero"><p class="eyebrow">像素縮放</p><h1>{title}</h1><p>{body}</p></div><ResizeTool client:load locale="zh-tw" /><section class="cards"><h2>瀏覽器縮放方式</h2><p>原圖會在瀏覽器 Worker 中解碼、繪製到新畫布，再於本機編碼並提供下載。透明背景會以 PNG 或 WebP 匯出保留。</p></section></> : isCropTool ? <><div class="hero"><p class="eyebrow">圖片裁切</p><h1>{title}</h1><p>{body}</p></div><CropTool client:load locale="zh-tw" /><section class="cards"><h2>如何裁切</h2><p>拖曳或觸控設定裁切範圍，再以像素欄位微調左側、頂端、寬度和高度。</p></section></> : isSizeTool || isDpiTool ? <><div class="hero"><p class="eyebrow">圖片檢查</p><h1>{title}</h1><p>{body} 檔案只會在瀏覽器本機讀取。</p></div><ImageInfoTool client:load locale="zh-tw" mode={isSizeTool ? 'size' : 'dpi'} /><section class="cards"><h2>{isDpiTool ? '認識 DPI' : '支援的圖片資訊'}</h2><p>{isDpiTool ? 'DPI 是列印中繼資料，不會改變圖片像素尺寸。有些檔案不含 DPI 資訊。' : '支援最大 20 MB、4,000 萬像素的靜態 JPEG、PNG 和 WebP 圖片。'}</p></section></> : <FoundationContent locale="zh-tw" slug={slug} title={title} intro={body} />}{supportTool && <ToolSupportingContent locale="zh-tw" tool={supportTool} />}</div>
</BaseLayout>
