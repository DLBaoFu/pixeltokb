---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const sections = {
  compress: { title: '圖片壓縮', intro: '可以為 JPEG、PNG 或 WebP 設定精確位元組目標，也可以對一個或最多 20 個靜態 PNG 進行經過驗證的無損最佳化。', links: [['PNG 無損最佳化', '在本機最佳化 PNG，並將通過驗證且較小的結果個別下載或封裝為 ZIP。', '/zh-tw/compress-png/'], ['增加 JPEG 容量', '使用品質重新編碼或標準註解填充滿足最小位元組數要求。', '/zh-tw/increase-image-size/'], ['10–100 KB', '適合嚴格的表單和小圖片限制。', '/zh-tw/compress-image/?preset=10-100kb'], ['200–500 KB', '適合中等容量的照片和檔案。', '/zh-tw/compress-image/?preset=200-500kb'], ['500 KB–1 MB', '將較大圖片控制在 1 MB 內。', '/zh-tw/compress-image/?preset=500kb-1mb'], ['2–5 MB', '在較高容量上限下保留更多細節。', '/zh-tw/compress-image/?preset=2mb-5mb']] },
  resize: { title: '縮放與裁切', intro: '規劃比例、計算列印像素密度、調整圖片像素尺寸、裁切畫面範圍，或依實際檔案大小要求處理簽名圖片。', links: [['列印尺寸相片調整', '用毫米或英吋設定列印尺寸，並驗證 JPEG 或 PNG 的 DPI 中繼資料。', '/zh-tw/photo-resizer/'], ['相片與簽名合併', '將相片和簽名上下或左右合併為一個 PNG。', '/zh-tw/photo-signature-merger/'], ['相片紙 PDF', '依實際列印尺寸將多份相片排版到 A4 或 Letter。', '/zh-tw/print-photo-sheet/'], ['圖片長寬比計算器', '化簡寬高比例，並計算相符的像素邊長。', '/zh-tw/aspect-ratio-calculator/'], ['PPI 計算器', '依預計列印尺寸計算每英吋像素數，不修改圖片檔案。', '/zh-tw/ppi-calculator/'], ['縮放圖片', '設定精確寬高，再選擇符合、填滿或拉伸。', '/zh-tw/resize-image/'], ['裁切圖片', '直接選取裁切範圍，或透過像素座標微調。', '/zh-tw/crop-image/'], ['簽名圖片縮放', '裁切簽名區域，設定像素，並核對最終 JPEG 位元組限制。', '/zh-tw/signature-resizer/'], ['簽名圖片壓縮', '依所選簽名上傳大小處理白底 JPEG。', '/zh-tw/signature-compressor/'], ['簽名背景移除', '以本機色彩閾值移除均勻紙張或白色背景。', '/zh-tw/signature-background-remover/']] },
  forms: { title: '簽名與表單圖片', intro: '在上傳前於本機準備簽名圖片或列印尺寸相片，並自行核對尺寸和實際檔案資訊。', links: [['簽名圖片縮放', '裁切簽名區域、設定像素，並核對白底 JPEG 的實際位元組限制。', '/zh-tw/signature-resizer/'], ['簽名圖片壓縮', '無需把圖片上傳至伺服器，即可依所選限制處理白底 JPEG。', '/zh-tw/signature-compressor/'], ['相片與簽名合併', '在表單上傳前合併相片和簽名。', '/zh-tw/photo-signature-merger/'], ['相片紙 PDF', '建立包含多份相片的列印紙張。', '/zh-tw/print-photo-sheet/'], ['列印尺寸相片調整', '用毫米或英吋設定實體尺寸，並驗證匯出 JPEG 或 PNG 的 DPI 中繼資料。', '/zh-tw/photo-resizer/'], ['圖片大小檢查', '上傳前查看位元組、像素尺寸、格式、透明度和既有中繼資料。', '/zh-tw/image-size-checker/']] },
  inspect: { title: '圖片資訊檢查', intro: '上傳或傳送圖片前，先查看檔案本身和列印中繼資料。', links: [['圖片大小檢查', '查看位元組、KB 與 KiB、像素尺寸、長寬比和透明度。', '/zh-tw/image-size-checker/'], ['DPI 檢查', '讀取圖片檔案中實際包含的列印解析度中繼資料。', '/zh-tw/image-dpi-checker/']] }
};
export function getStaticPaths() { return ['compress', 'resize', 'forms', 'inspect'].map((category) => ({ params: { category }, props: { category } })); }
const section = sections[Astro.props.category as keyof typeof sections];
---
<BaseLayout locale="zh-tw" title={section.title} description={section.intro}><div class="directory-page"><div class="hero"><p class="eyebrow">PIXELTOKB · 工具</p><h1>{section.title}</h1><p>{section.intro}</p></div><div class="tool-card-grid">{section.links.map(([title, text, href]) => <a class="tool-card" href={href}><span class="directory-icon" aria-hidden="true">✳</span><h2>{title}</h2><p>{text}</p><span class="card-action">開啟工具 <span aria-hidden="true">→</span></span></a>)}</div><div class="directory-section"><p><a href="/zh-tw/tools/">← 所有圖片工具</a></p></div></div></BaseLayout>
