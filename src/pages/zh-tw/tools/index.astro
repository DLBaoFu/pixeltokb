---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const tools = [
  { icon: '↘', title: '壓縮圖片', text: '在同一套工具中設定 1 KB 到 5 MB 的目標，並使用常見區間快速入口。', href: '/zh-tw/compress-image/', action: '開啟壓縮工具' },
  { icon: '▦', title: 'PNG 無損最佳化', text: '在本機最佳化一個或最多 20 個 PNG；通過驗證且較小的結果可個別下載或封裝為 ZIP。', href: '/zh-tw/compress-png/', action: '最佳化 PNG 檔案' },
  { icon: '✒', title: '簽名圖片縮放', text: '裁切簽名區域，設定精確像素，並在本機核對白底 JPEG 的檔案大小。', href: '/zh-tw/signature-resizer/', action: '處理簽名圖片' },
  { icon: '⌁', title: '簽名圖片壓縮', text: '無需上傳圖片，即可依所選檔案大小限制處理簽名 JPEG。', href: '/zh-tw/signature-compressor/', action: '壓縮簽名圖片' },
  { icon: '◌', title: '簽名背景移除', text: '以本機閾值將均勻紙張或白色簽名背景變透明。', href: '/zh-tw/signature-background-remover/', action: '移除背景' },
  { icon: '⊞', title: '相片與簽名合併', text: '在本機將相片和簽名上下或左右合併為一個 PNG。', href: '/zh-tw/photo-signature-merger/', action: '合併兩張圖片' },
  { icon: '▤', title: '相片紙 PDF', text: '依實際列印尺寸將多份相片排版到 A4 或 Letter PDF。', href: '/zh-tw/print-photo-sheet/', action: '建立相片紙' },
  { icon: '↗', title: '增加 JPEG 容量', text: '使用品質重新編碼或標準 JPEG 註解填充滿足位元組數要求。', href: '/zh-tw/increase-image-size/', action: '增加檔案容量' },
  { icon: '∶', title: '圖片長寬比計算器', text: '將寬高化為最簡比例，並計算相符的像素邊長。', href: '/zh-tw/aspect-ratio-calculator/', action: '計算長寬比' },
  { icon: '◎', title: 'PPI 計算器', text: '依圖片像素與預計列印尺寸計算像素密度。', href: '/zh-tw/ppi-calculator/', action: '計算 PPI' },
  { icon: '▧', title: '列印尺寸相片調整', text: '用毫米或英吋設定列印尺寸，並驗證 JPEG 或 PNG 的 DPI 中繼資料。', href: '/zh-tw/photo-resizer/', action: '調整相片尺寸' },
  { icon: '↔', title: '縮放圖片', text: '設定精確的像素寬高，並選擇合適的調整方式。', href: '/zh-tw/resize-image/', action: '調整圖片尺寸' },
  { icon: '⌗', title: '裁切圖片', text: '直接在預覽圖上選取範圍，或輸入像素座標。', href: '/zh-tw/crop-image/', action: '開啟裁切工具' },
  { icon: '▤', title: '圖片大小檢查', text: '查看精確位元組數、KB 與 KiB、像素尺寸和透明度。', href: '/zh-tw/image-size-checker/', action: '檢查圖片資訊' },
  { icon: '◉', title: 'DPI 檢查', text: '讀取檔案中實際存在的列印解析度中繼資料。', href: '/zh-tw/image-dpi-checker/', action: '查看 DPI' }
];
const ranges = [['10–100 KB', '/zh-tw/compress-image/?preset=10-100kb'], ['200–500 KB', '/zh-tw/compress-image/?preset=200-500kb'], ['500 KB–1 MB', '/zh-tw/compress-image/?preset=500kb-1mb'], ['2–5 MB', '/zh-tw/compress-image/?preset=2mb-5mb']];
---
<BaseLayout locale="zh-tw" title="圖片工具" description="在瀏覽器本機壓縮和最佳化圖片、縮放像素、裁切並檢查檔案資訊。">
  <div class="directory-page"><div class="hero"><p class="eyebrow">PIXELTOKB · 圖片工作區</p><h1>重視每個細節的圖片工具。</h1><p>縮小檔案容量、設定精確像素尺寸，或檢查圖片中繼資料——全程在瀏覽器本機完成，圖片不會離開你的裝置。</p></div><div class="directory-note"><span aria-hidden="true">✳</span><div><strong>以隱私為優先</strong>檔案只會在瀏覽器中處理，不會上傳至 pixeltokb 伺服器。</div></div><div class="tool-card-grid">{tools.map((tool) => <a class="tool-card" href={tool.href}><span class="directory-icon" aria-hidden="true">{tool.icon}</span><h2>{tool.title}</h2><p>{tool.text}</p><span class="card-action">{tool.action}<span aria-hidden="true">→</span></span></a>)}</div><section class="directory-section"><h2>依任務瀏覽</h2><div class="category-nav"><a href="/zh-tw/tools/compress/">圖片壓縮</a><a href="/zh-tw/tools/resize/">縮放與裁切</a><a href="/zh-tw/tools/forms/">簽名與表單圖片</a><a href="/zh-tw/tools/inspect/">圖片資訊檢查</a></div></section><section class="directory-section"><h2>選擇壓縮規格</h2><p>每個入口都會開啟同一套壓縮工具，並預先選取建議目標；你仍可修改目標、單位、格式和尺寸設定。</p><div class="preset-links">{ranges.map(([label, href]) => <a class="preset-link" href={href}><strong>{label}</strong><span>開啟壓縮工具 →</span></a>)}</div></section></div>
</BaseLayout>
