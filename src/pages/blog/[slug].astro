---
import GuideArticle from '../../components/GuideArticle.astro';
import { blogRouteSlugs } from '../../lib/blog-content';
export function getStaticPaths() { return blogRouteSlugs('en').map((slug) => ({ params: { slug }, props: { slug } })); }
const { slug } = Astro.props;
---
<GuideArticle locale="en" slug={slug} />
