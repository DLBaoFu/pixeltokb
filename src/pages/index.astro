---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompressionTool from '../components/CompressionTool';
---
<BaseLayout title="Compress images online to exact KB sizes" description="Compress JPEG, PNG, and WebP images online to exact targets from 10 KB to 5 MB. Resize, crop, and inspect images privately in your browser with no upload." application>
  <div class="home-shell"><div class="hero"><h1>Compress images to an exact <span>size.</span></h1><p>Compress JPEG, PNG, and WebP to a target KB size, resize pixels, crop, or inspect image details without uploading.</p></div><CompressionTool client:load /></div>
</BaseLayout>
