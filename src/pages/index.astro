---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompressionTool from '../components/CompressionTool';
---
<BaseLayout title="Image size reducer online — compress to a target KB" description="Reduce JPEG, PNG, and WebP file size online with PixelTokb. Choose a custom KB target, preview the result, and download the checked file locally." application>
  <div class="home-shell"><div class="hero"><h1>Compress images to an exact <span>size.</span></h1><p>Reduce image file size online to a target KB. PixelTokb accepts static JPEG, PNG, and WebP files, processes them in your browser, and lets you preview and download the checked result.</p></div><CompressionTool client:load /></div>
</BaseLayout>
