---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompressionTool from '../components/CompressionTool';
---
<BaseLayout title="Compress images online to an exact target size" description="Compress JPEG, PNG, and WebP images locally in your browser to verified targets from 10 KB to 5 MB, with presets and custom byte limits.">
  <div class="home-shell"><div class="hero"><h1>Make every pixel <span>fit.</span></h1><p>Compress, resize, and inspect images locally in your browser.</p></div><CompressionTool client:load /></div>
</BaseLayout>
